        static applySavedPrefsToUi() {

            const prefs = DataManager.loadPrefs();

            if (prefs) {

                if (typeof prefs.bot === 'boolean') BotState.config.BOT_RUNNING = prefs.bot;

                if (typeof prefs.tg === 'boolean') BotState.config.TELEGRAM_ENABLED = prefs.tg;

                if (typeof prefs.autoTrade === 'boolean') BotState.config.AUTOTRADE_ENABLED = prefs.autoTrade;

                if (typeof prefs.multiPar === 'boolean') BotState.config.MULTI_PAR_ENABLED = prefs.multiPar;

                if (typeof prefs.martingale === 'boolean') BotState.config.MARTINGALE_ENABLED = prefs.martingale;

                if (typeof prefs.autoKill === 'boolean') BotState.config.AUTO_KILL_ENABLED = prefs.autoKill;

                if (prefs.mode) BotState.config.OPERATION_MODE = prefs.mode;

                if (prefs.minPayout) BotState.config.MIN_PAYOUT = prefs.minPayout;

                if (prefs.minConf) BotState.config.MIN_CONFLUENCE_SCORE = prefs.minConf;

                if (prefs.pull) BotState.config.PULLBACK_LEVEL = prefs.pull;

                if (prefs.eng) BotState.config.ENGULF_LEVEL = prefs.eng;

                if (prefs.enables) {

                    for (const ek in prefs.enables) {

                        if (prefs.enables.hasOwnProperty(ek)) {

                            BotState.config[ek] = prefs.enables[ek];

                        }

                    }

                }

                if (prefs.positionSize) BotState.config.POSITION_SIZE_PERCENTAGE = prefs.positionSize;

                if (prefs.maxDrawdown) BotState.config.MAX_DRAWDOWN_PERCENTAGE = prefs.maxDrawdown;

            }

            document.getElementById('po-vip-bot-toggle').classList.toggle('on', BotState.config.BOT_RUNNING);

            document.getElementById('po-vip-tg-toggle').classList.toggle('on', BotState.config.TELEGRAM_ENABLED);

            document.getElementById('po-vip-autokill-toggle').classList.toggle('on', BotState.config.AUTO_KILL_ENABLED);

            document.getElementById('po-vip-autotrade-toggle').classList.toggle('on', BotState.config.AUTOTRADE_ENABLED);

            document.getElementById('po-vip-multipar-toggle').classList.toggle('on', BotState.config.MULTI_PAR_ENABLED);

            document.getElementById('po-vip-martingale-toggle').classList.toggle('on', BotState.config.MARTINGALE_ENABLED);

            document.getElementById('po-vip-min-conf').value = BotState.config.MIN_CONFLUENCE_SCORE;

            document.getElementById('po-vip-op-mode').value = BotState.config.OPERATION_MODE;

            document.getElementById('po-vip-min-payout').value = BotState.config.MIN_PAYOUT;

            document.getElementById('po-vip-pull-level').value = BotState.config.PULLBACK_LEVEL;

            document.getElementById('po-vip-eng-level').value = BotState.config.ENGULF_LEVEL;

            document.getElementById('po-status-badge').textContent = BotState.config.BOT_RUNNING ? '🟢 LIVE' : '🔴 OFF';


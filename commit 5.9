    // ==================== WEB SOCKET HANDLER ====================

    function startWebSocketHandler() {

        const OriginalWS = win.WebSocket;

        win.WebSocket = function(url, protocols) {

            const ws = protocols !== undefined ?

                       new OriginalWS(url, protocols) :

                       new OriginalWS(url);

            ws.addEventListener('message', function(e) {

                const d = e.data;

                if (typeof d === 'string') {

                    tryParseText(d);

                } else if (typeof Blob !== 'undefined' && d instanceof Blob) {

                    d.arrayBuffer().then(handleBinaryFrame).catch(function(){});

                } else if (typeof ArrayBuffer !== 'undefined' && d instanceof ArrayBuffer) {

                    handleBinaryFrame(d);

                }

            });

            return ws;

        };

        win.WebSocket.prototype = OriginalWS.prototype;

    }

    function extractTicks(obj) {

        if (obj == null) return;

        if (Array.isArray(obj)) {

            if (obj.length >= 3 && typeof obj[0] === 'string' && typeof obj[1] === 'number' && typeof obj[2] === 'number') {

                DataManager.processTick(obj[0], obj[1], obj[2]);

                return;

            }

            for (let i = 0; i < obj.length; i++) {

                extractTicks(obj[i]);

            }

            return;

        }

        if (typeof obj !== 'object') return;

        for (const key in obj) {

            if (!obj.hasOwnProperty(key)) continue;

            const val = obj[key];

            if (val && typeof val === 'object' && !Array.isArray(val) && val.time != null && val.price != null) {

                const t = Number(val.time);

                const p = Number(val.price);

                if (isFinite(t) && isFinite(p)) {

                    DataManager.processTick(key, t, p);

                }

            } else if (val && typeof val === 'object') {

                extractTicks(val);

            }

        }

    }

    function tryParseText(msg) {

        if (typeof msg !== 'string') return;

        const i = msg.search(/[\{\[]/);

        if (i === -1) return;

        try {

            extractTicks(JSON.parse(msg.substring(i)));

        } catch (e) {}

    }

    function handleBinaryFrame(buf) {

        try {

            const text = new TextDecoder('utf-8', { fatal: false }).decode(new Uint8Array(buf));

            const j = text.search(/[\{\[]/);

            if (j !== -1) {

                try {

                    extractTicks(JSON.parse(text.substring(j)));

                } catch (e2) {}

            }

        } catch (e) {}

    }

    // ==================== INITIALIZATION ====================

    function init() {

        DataManager.initialize();

        startWebSocketHandler();

        UIController.ensurePanel();

        DataManager.uiLog('Bot v5.9 PRO iniciado');

    }

    // Start the bot

    init();


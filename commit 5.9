        static setAllPairsEnabled(on) {

            for (const k in BotState.pairWatch) {

                if (BotState.pairWatch.hasOwnProperty(k)) {

                    BotState.pairWatch[k].enabled = on;

                    BotState.pairWatch[k].paused = false;

                }

            }

            DataManager.savePairStates();

            UIController.renderPairList();

        }

        static renderPairList() {

            const box = document.getElementById('po-vip-pairs');

            if (!box) return;

            const keys = Object.keys(BotState.pairWatch).sort();

            if (!keys.length) {

                box.innerHTML = '<span class="muted">Esperando ticks...</span>';

                return;

            }

            let html = '';

            for (let i = 0; i < keys.length; i++) {

                const p = keys[i];

                const en = BotState.pairWatch[p].enabled !== false;

                const paused = BotState.pairWatch[p].paused === true;

                const dead = BotState.deadZonePauseUntil[p] && Date.now() < BotState.deadZonePauseUntil[p];

                const pay = BotState.pairPayouts[p] || 85;

                const color = pay >= 85 ? '#4ade80' : pay >= 80 ? '#fbbf24' : '#f87171';

                const cls = 'pair-card' + (en ? '' : ' off') + (paused || dead ? ' paused' : '');

                html += '<div class="' + cls + '"><span style="cursor:pointer" data-toggle-pair="' + this.escapeAttr(p) + '">' +

                       DataManager.formatPairDisplay(p) + ' <b style="color:' + color + '">' + pay + '%</b>' +

                       (dead ? ' 💤' : '') + '</span></div>';

            }

            box.innerHTML = html;

            box.querySelectorAll('[data-toggle-pair]').forEach(function (el) {

                el.addEventListener('click', function () {

                    const pair = this.getAttribute('data-toggle-pair');

                    if (BotState.pairWatch[pair]) {

                        if (BotState.pairWatch[pair].paused) {

                            BotState.pairWatch[pair].paused = false;

                            BotState.pairWatch[pair].enabled = true;

                        } else {

                            BotState.pairWatch[pair].enabled = !BotState.pairWatch[pair].enabled;

                        }

                        DataManager.savePairStates();

                        UIController.renderPairList();

                    }

                });

            });

        }

        static renderPanelLog() {

            const el = document.getElementById('po-vip-log');

            if (!el) return;

            let html = '';

            for (let i = 0; i < BotState.localLog.length; i++) {

                const line = BotState.localLog[i];

                let cls = '';

                const msg = line.msg || line;

                if (typeof line === 'object') {

                    if (msg.indexOf('WIN') !== -1) cls = 'color:#4ade80;';

                    else if (msg.indexOf('LOSS') !== -1) cls = 'color:#f87171;';

                    else if (msg.indexOf('SEÑAL') !== -1) cls = 'color:#38bdf8;';

                    html += '<div style="' + cls + '"><span style="color:#475569;">' + line.t + '</span> ' + msg + '</div>';

                } else {

                    html += '<div>' + line + '</div>';

                }

            }

            el.innerHTML = html;

            el.scrollTop = el.scrollHeight;

        }

        static countSessionWL() {

            let w = 0;

            let l = 0;

            for (let i = 0; i < BotState.sessionLog.length; i++) {

                if (BotState.sessionLog[i].win) w++;

                else l++;

            }

            return { w: w, l: l, tot: w + l };

        }

        static refreshPanelLive() {

            if (!BotState.panelReady) return;

            const wl = this.countSessionWL();

            document.getElementById('m-signals').textContent = wl.tot;

            document.getElementById('m-wins').textContent = wl.w;

            document.getElementById('m-losses').textContent = wl.l;

            const wr = wl.tot ? Math.round((wl.w / wl.tot) * 100) : 0;

            document.getElementById('m-wr').textContent = wr + '%';

            document.getElementById('po-global-wr').textContent = 'WR ' + wr + '%';

            const sigEl = document.getElementById('po-vip-signal');

            if (BotState.lastSignalUI) {

                sigEl.innerHTML = '<div style="font-weight:600;">' + BotState.lastSignalUI.pair + '</div>' +

                                  '<div class="po-vip-dir" style="color:' +

                                  (BotState.lastSignalUI.dir === 'CALL' ? '#4ade80' : '#f87171') + '">' +

                                  BotState.lastSignalUI.dir + '</div>' +

                                  '<div class="muted">' + BotState.lastSignalUI.motor + ' · ' + BotState.lastSignalUI.hm + '</div>';

            } else {

                sigEl.innerHTML = '<div class="muted">Sin señal activa</div>';

            }

            this.updateMotorStatsUI();

            const atStatus = document.getElementById('po-autotrade-status');

            if (atStatus) {

                if (BotState.config.AUTOTRADE_ENABLED) {

                    const visiblePair = DataManager.getVisiblePairFromUI();

                    const modeText = BotState.config.MULTI_PAR_ENABLED ? ' (Multi)' : '';

                    if (visiblePair) {

                        atStatus.textContent = '🟢 ' + DataManager.formatPairDisplay(visiblePair) + modeText;

                        atStatus.style.color = '#4ade80';

                    } else {

                        atStatus.textContent = '🟡 Esperando par' + modeText;

                        atStatus.style.color = '#fbbf24';

                    }

                } else {

                    atStatus.textContent = '';

                }

            }

        }

        static updateMotorStatsUI() {

            const el = document.getElementById('po-vip-motor-stats');

            if (!el) return;

            const keys = Object.keys(BotState.statsByMotor).sort(function(a, b) {

                return (BotState.statsByMotor[b].w + BotState.statsByMotor[b].wG1 + BotState.statsByMotor[b].l) -

                       (BotState.statsByMotor[a].w + BotState.statsByMotor[a].wG1 + BotState.statsByMotor[a].l);

            });

            if (!keys.length) {

                el.innerHTML = '<span class="muted">Sin datos</span>';

                return;

            }

            let html = '';

            for (let i = 0; i < keys.length; i++) {

                const m = keys[i];

                const s = BotState.statsByMotor[m];

                const total = s.w + s.wG1 + s.l;

                const wr = total ? Math.round(((s.w + s.wG1) / total) * 100) : 0;

                const paused = BotState.motorPausedUntil[m] && Date.now() < BotState.motorPausedUntil[m];

                const status = paused ? ' ⏸️' : '';

                html += '<div class="motor-row"><span>' + m + ' (' + total + ')' + status + '</span><span style="color:#4ade80;">W' +

                       (s.w + s.wG1) + '</span> <span style="color:#f87171;">L' + s.l + '</span> <span style="color:#fbbf24;">' + wr + '%</span></div>';

            }

            el.innerHTML = html;

        }

        static autoTop3() {

            const motorNames = [

                { key: 'ENABLE_BOLLINGER', name: 'Bollinger Bounce' },

                { key: 'ENABLE_PINBAR', name: 'Pin Bar Rejection' },

                { key: 'ENABLE_INSIDE_BAR', name: 'Inside Bar Break' },

                { key: 'ENABLE_ALLIGATOR', name: 'Impulso Alligator' },

                { key: 'ENABLE_GAP_FILL', name: 'Gap Fill' },

                { key: 'ENABLE_PULLBACK', name: 'Pullback Fib' },

                { key: 'ENABLE_ENGULFING', name: 'PA · Engulfing' },

                { key: 'ENABLE_GAP', name: 'PA · Gap' },

                { key: 'ENABLE_TRAP_WICK', name: 'Trap Wick Fade' },

                { key: 'ENABLE_FALSE_BREAK', name: 'False Break Fade' }

            ];

            const valid = [];

            for (let i = 0; i < motorNames.length; i++) {

                const m = motorNames[i];

                const stats = BotState.statsByMotor[m.name];

                if (stats && (stats.w + stats.wG1 + stats.l) >= 5) {

                    const wr = (stats.w + stats.wG1) / (stats.w + stats.wG1 + stats.l);

                    valid.push({ key: m.key, wr: wr });

                }

            }

            valid.sort(function(a, b) { return b.wr - a.wr; });

            const top3Keys = valid.slice(0, 3).map(function(x) { return x.key; });

            for (let j = 0; j < motorNames.length; j++) {

                BotState.config[motorNames[j].key] = false;

            }

            for (let k = 0; k < top3Keys.length; k++) {

                BotState.config[top3Keys[k]] = true;

            }

            DataManager.uiLog('⚡ Auto-Top 3: ' + top3Keys.join(', '));

            DataManager.savePrefs();

            UIController.applySavedPrefsToUi();

        }

        static exportLossCSV() {

            if (BotState.lossLog.length === 0) {

                DataManager.uiLog('No hay datos de pérdidas para exportar');

                return;

            }

            let csvContent = "data:text/csv;charset=utf-8,";

            csvContent += "Fecha,Hora,Par,Motor,Dirección,Apertura,Cierre,Máximo,Mínimo,Mecha Sup,Mecha Inf,Cuerpo,RSI,Payout,Ticks\n";

            for (let i = 0; i < BotState.lossLog.length; i++) {

                const l = BotState.lossLog[i];

                const row = [

                    l.date, l.time, l.pair, l.motor, l.dir,

                    l.open, l.close, l.high, l.low,

                    l.upperWick, l.lowerWick, l.body,

                    l.rsi, l.payout, l.ticks

                ].join(',');

                csvContent += row + "\n";

            }

            const encodedUri = encodeURI(csvContent);

            const link = document.createElement("a");

            link.setAttribute("href", encodedUri);

            link.setAttribute("download", "losses_" + new Date().toISOString().slice(0,10) + ".csv");

            document.body.appendChild(link);

            link.click();

            document.body.removeChild(link);

            DataManager.uiLog('📥 CSV exportado (' + BotState.lossLog.length + ' pérdidas)');

        }

        static escapeAttr(s) {

            return String(s).replace(/&/g, '&amp;')

                           .replace(/"/g, '&quot;')

                           .replace(/</g, '&lt;')

                           .replace(/>/g, '&gt;');

        }


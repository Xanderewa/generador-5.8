                return raw ? JSON.parse(raw) : null;

            } catch (e) {

                return null;

            }

        }

    }

    // ==================== INDICATOR ENGINE ====================

    class IndicatorEngine {

        static candleMetrics(c) {

            const body = Math.abs(c.close - c.open);

            const range = c.high - c.low;

            return {

                body,

                range,

                bodyRatio: range > 0 ? body / range : 0,

                upperWick: c.high - Math.max(c.open, c.close),

                lowerWick: Math.min(c.open, c.close) - c.low,

                bullish: c.close >= c.open

            };

        }

        static avgRange(candles, n) {

            if (!candles.length) return 0;

            const s = candles.slice(-n);

            let sum = 0;

            for (let i = 0; i < s.length; i++) {

                sum += s[i].high - s[i].low;

            }

            return sum / s.length;

        }

        static getSMA(closes, period, offset = 0) {

            if (closes.length < period + offset) return 0;

            const start = closes.length - period - offset;

            let sum = 0;

            for (let i = start; i < start + period; i++) {

                sum += closes[i];

            }

            return sum / period;

        }

        static getRSI(closes, period) {

            if (closes.length < period + 1) return 50;

            let gains = 0;

            let losses = 0;

            for (let i = closes.length - period; i < closes.length; i++) {

                const diff = closes[i] - closes[i - 1];

                if (diff > 0) gains += diff;

                else losses -= diff;

            }

            const ag = gains / period;

            const al = losses / period;

            return al === 0 ? 100 : 100 - 100 / (1 + ag / al);

        }

        static getSMAWithShift(closes, period, shift) {

            const start = closes.length - period - shift;

            if (start < 0) return 0;

            let sum = 0;

            for (let i = start; i < start + period; i++) {

                sum += closes[i];

            }

            return sum / period;

        }

        static getDeMarker(highs, lows, period, shift) {

            const end = highs.length - shift;

            const start = end - period;

            if (start < 0) return 50;

            let sumMax = 0;

            let sumMin = 0;

            for (let i = start; i < end; i++) {

                sumMax += highs[i] > highs[i - 1] ? highs[i] - highs[i - 1] : 0;

                sumMin += lows[i] < lows[i - 1] ? lows[i - 1] - lows[i] : 0;

            }

            const a = sumMax / period;

            const b = sumMin / period;

            return a + b === 0 ? 50 : a / (a + b) * 100;

        }

        static getMomentum(closes, period) {

            return closes.length <= period ? 0 : closes[closes.length - 1] - closes[closes.length - 1 - period];

        }

        static getStochastic(highs, lows, closes, period, kSmooth, dSmooth) {

            if (closes.length < period + kSmooth) return { k: 50, d: 50 };

            const rawK = [];

            for (let i = period - 1; i < closes.length; i++) {

                let hh = -Infinity;

                let ll = Infinity;

                for (let j = i - period + 1; j <= i; j++) {

                    if (highs[j] > hh) hh = highs[j];

                    if (lows[j] < ll) ll = lows[j];

                }

                rawK.push(hh === ll ? 50 : (closes[i] - ll) / (hh - ll) * 100);

            }

            const smoothK = [];

            for (let s = 0; s <= rawK.length - kSmooth; s++) {

                let sum = 0;

                for (let x = 0; x < kSmooth; x++) sum += rawK[s + x];

                smoothK.push(sum / kSmooth);

            }

            const k = smoothK[smoothK.length - 1];

            let d = k;

            if (smoothK.length >= dSmooth) {

                let sumD = 0;

                for (let y = smoothK.length - dSmooth; y < smoothK.length; y++) sumD += smoothK[y];

                d = sumD / dSmooth;

            }

            return { k, d };

        }

        static getEMA(closes, period) {

            if (closes.length < period) return 0;

            const k = 2 / (period + 1);

            let ema = closes[closes.length - period];

            for (let i = closes.length - period + 1; i < closes.length; i++) {

                ema = closes[i] * k + ema * (1 - k);

            }

            return ema;

        }

        static getBollinger(closes, period, stdMult) {

            if (closes.length < period) return { mid: 0, upper: 0, lower: 0 };

            const slice = closes.slice(-period);

            let sum = 0;

            for (let i = 0; i < slice.length; i++) {

                sum += slice[i];

            }

            const mid = sum / period;

            let variance = 0;

            for (let i = 0; i < slice.length; i++) {

                variance += Math.pow(slice[i] - mid, 2);

            }

            const std = Math.sqrt(variance / period);

            return {

                mid,

                upper: mid + std * stdMult,

                lower: mid - std * stdMult

            };

        }

        static m1Bias(m1) {

            if (m1.length < 4) return 'FLAT';

            const a = m1[m1.length - 2].close;

            const b = m1[m1.length - 4].close;

            return a > b ? 'UP' : a < b ? 'DOWN' : 'FLAT';

        }

        static regimeOK(m1Sim, chaos, dead, chop) {

            if (m1Sim.length < 8) return false;

            const avg = this.avgRange(m1Sim.slice(0, -1), 6);

            if (avg <= 0) return false;

            const cur = m1Sim[m1Sim.length - 1];

            const r = cur.high - cur.low;

            if (r > avg * chaos || r < avg * dead) return false;

            const slice = m1Sim.slice(-chop);

            let alts = 0;

            let small = 0;

            for (let i = 1; i < slice.length; i++) {

                const m = this.candleMetrics(slice[i]);

                if (m.bodyRatio < 0.35) small++;

                if ((slice[i].close >= slice[i].open) !== (slice[i - 1].close >= slice[i - 1].open)) alts++;

            }

            return !(small >= 4 && alts >= 4);

        }

        static swingLevels(m1Sim) {

            const slice = m1Sim.slice(-BotState.config.SWING_LOOKBACK, -1);

            if (!slice.length) return { maxH: 0, minL: 0, range: 0 };

            let maxH = -Infinity;

            let minL = Infinity;

            for (let i = 0; i < slice.length; i++) {

                if (slice[i].high > maxH) maxH = slice[i].high;

                if (slice[i].low < minL) minL = slice[i].low;

            }

            return { maxH, minL, range: maxH - minL };

        }

        static nearSR(price, levels, prox) {

            if (levels.range <= 0) return false;

            const band = levels.range * prox;

            return Math.abs(price - levels.maxH) <= band || Math.abs(price - levels.minL) <= band;

        }

        static checkDeadZone(pairLabel, m1Sim) {

            if (m1Sim.length < BotState.config.DEAD_ZONE_MINUTES) return false;

            const slice = m1Sim.slice(-BotState.config.DEAD_ZONE_MINUTES);

            let maxH = -Infinity;

            let minL = Infinity;

            for (let i = 0; i < slice.length; i++) {

                if (slice[i].high > maxH) maxH = slice[i].high;

                if (slice[i].low < minL) minL = slice[i].low;

            }

            const range = maxH - minL;

            const price = m1Sim[m1Sim.length - 1].close;

            if (price > 0 && range / price < BotState.config.DEAD_ZONE_PCT) {

                BotState.deadZonePauseUntil[pairLabel] = Date.now() + BotState.config.DEAD_ZONE_PAUSE_MINUTES * 60000;

                DataManager.uiLog('💤 Zona muerta ' + DataManager.formatPairDisplay(pairLabel) + ' - Pausado ' + BotState.config.DEAD_ZONE_PAUSE_MINUTES + ' min');

                return true;

            }

            return false;

        }

        static detectCandlePatterns(candle, prevCandle) {

            const patterns = [];

            const metrics = this.candleMetrics(candle);

            // Engulfing pattern

            if (prevCandle) {

                const prevMetrics = this.candleMetrics(prevCandle);

                if (metrics.bullish && !prevMetrics.bullish &&

                    candle.close >= prevCandle.open && candle.open <= prevCandle.close) {

                    patterns.push('engulfing_bullish');

                } else if (!metrics.bullish && prevMetrics.bullish &&

                           candle.close <= prevCandle.open && candle.open >= prevCandle.close) {

                    patterns.push('engulfing_bearish');

                }

            }

            // Pin bar pattern

            if (metrics.upperWick / metrics.range >= 0.55 && metrics.bodyRatio <= 0.35 && !metrics.bullish) {

                patterns.push('pin_bar_bearish');

            }

            if (metrics.lowerWick / metrics.range >= 0.55 && metrics.bodyRatio <= 0.35 && metrics.bullish) {

                patterns.push('pin_bar_bullish');

            }

            // Inside bar pattern

            if (prevCandle && candle.high <= prevCandle.high && candle.low >= prevCandle.low) {

                patterns.push('inside_bar');

            }

            // Doji pattern

            if (metrics.bodyRatio <= 0.1) {

                patterns.push('doji');

            }

            return patterns;

        }

    }

    // ==================== STRATEGY ENGINE ====================

    class StrategyEngine {

        static evaluateAll(pair, time) {

            if (!BotState.config.BOT_RUNNING || BotState.cyclesToday >= BotState.config.MAX_SIGNALS_SESSION) return;

            if (BotState.config.OPERATION_MODE === 'normal' && DataManager.hasOpenCycle()) return;

            if (BotState.activeTrades[pair] || BotState.pendingTrades[pair]) return;

            if (!IndicatorEngine.regimeOK(

                BotState.history[pair].m1,

                BotState.config.CHAOS_MULT,

                BotState.config.DEAD_RATIO,

                BotState.config.CHOP_LOOKBACK

            ) || IndicatorEngine.checkDeadZone(pair, BotState.history[pair].m1)) return;

            // New filters based on CSV

            const curPrice = BotState.history[pair].m1[BotState.history[pair].m1.length - 1].close;

            if (curPrice < BotState.config.MIN_PRICE_FILTER) return;

            if ((BotState.tickCountByPair[pair] || 0) < BotState.config.MIN_TICKS_PER_CANDLE) return;

            const payout = BotState.pairPayouts[pair] || 85;

            if (payout < BotState.config.MIN_PAYOUT) {

                if (BotState.pairWatch[pair] && !BotState.pairWatch[pair].paused) {

                    BotState.pairWatch[pair].paused = true;

                    DataManager.uiLog('🟡 Auto-pausa ' + DataManager.formatPairDisplay(pair) + ' (Payout ' + payout + '%)');

                    DataManager.savePairStates();

                    UIController.renderPairList();

                }

                return;

            } else if (BotState.pairWatch[pair] && BotState.pairWatch[pair].paused) {

                BotState.pairWatch[pair].paused = false;

                DataManager.uiLog('🟢 Auto-reactiva ' + DataManager.formatPairDisplay(pair));

                DataManager.savePairStates();

                UIController.renderPairList();

            }

            if (!DataManager.isPairEnabled(pair) ||

                (BotState.tickCountByPair[pair] || 0) < BotState.config.MIN_TICKS_PER_CANDLE) return;

            const share = this.getPairShare(pair);

            if (share > BotState.config.PAIR_MAX_SHARE) return;

            const levels = IndicatorEngine.swingLevels(BotState.history[pair].m1);

            const cur = BotState.history[pair].m1[BotState.history[pair].m1.length - 1];

            const m = IndicatorEngine.candleMetrics(cur);

            const closes = BotState.history[pair].m1.map(c => c.close);

            const highs = BotState.history[pair].m1.map(c => c.high);

            const lows = BotState.history[pair].m1.map(c => c.low);

            const maUp = IndicatorEngine.getSMA(closes, BotState.config.MA_PERIOD, 0) >

                         IndicatorEngine.getSMA(closes, BotState.config.MA_PERIOD, BotState.config.MA_SLOPE_LOOKBACK);

            const atr = IndicatorEngine.avgRange(BotState.history[pair].m1.slice(0, -1), 6);

            const candidates = [];

            function addCandidate(dir, motor, scoreObj, bonus) {

                if (this.isMotorPaused(motor)) return;

                const sc = scoreObj.total + (bonus || 0);

                // RSI dead zone filter

                if (BotState.config.RSI_DEAD_ZONE > 0 &&

                    Math.abs(scoreObj.rsiValue - 50) < BotState.config.RSI_DEAD_ZONE) return;

                if (sc >= BotState.config.MIN_CONFLUENCE_SCORE) {

                    candidates.push({ dir, motor, score: sc, metrics: scoreObj });

                }

            }

            // 1. Gap (REACTIVATED - relaxed parameters)

            if (BotState.config.ENABLE_GAP && BotState.history[pair].m1.length >= 2) {

                const prev = BotState.history[pair].m1[BotState.history[pair].m1.length - 2];

                const gap = prev.close !== 0 ? (cur.open - prev.close) / Math.abs(prev.close) : 0;

                if (gap >= BotState.config.PA_GAP_MIN_PCT && m.bullish && m.bodyRatio >= BotState.config.PA_MIN_BODY &&

                    (maUp || IndicatorEngine.m1Bias(BotState.history[pair].m1) === 'UP')) {

                    const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                    addCandidate('CALL', 'PA · Gap', score, 0);

                }

                if (gap <= -BotState.config.PA_GAP_MIN_PCT && !m.bullish && m.bodyRatio >= BotState.config.PA_MIN_BODY &&

                    (!maUp || IndicatorEngine.m1Bias(BotState.history[pair].m1) === 'DOWN')) {

                    const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                    addCandidate('PUT', 'PA · Gap', score, 0);

                }

            }

            // 2. Gap Fill

            if (BotState.config.ENABLE_GAP_FILL && BotState.history[pair].m1.length >= 2) {

                const prevGap = BotState.history[pair].m1[BotState.history[pair].m1.length - 2];

                const gapSize = prevGap.close !== 0 ? (cur.open - prevGap.close) / Math.abs(prevGap.close) : 0;

                const gapAbs = Math.abs(gapSize);

                if (gapAbs >= 0.00015 && gapAbs < 0.0008 && m.bodyRatio >= 0.3) {

                    if (gapSize > 0 && !m.bullish && cur.close < prevGap.close + (cur.open - prevGap.close) * 0.6) {

                        const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                        addCandidate('PUT', 'Gap Fill', score, 0);

                    }

                    if (gapSize < 0 && m.bullish && cur.close > prevGap.close + (cur.open - prevGap.close) * 0.6) {

                        const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                        addCandidate('CALL', 'Gap Fill', score, 0);

                    }

                }

            }

            // 3. Trap Wick (REACTIVATED - relaxed parameters)

            if (BotState.config.ENABLE_TRAP_WICK && m.range > 0 && levels.range > 0) {

                if (m.upperWick / m.range >= BotState.config.PA_PIN_TRAP_WICK && !m.bullish &&

                    IndicatorEngine.nearSR(cur.close, levels, BotState.config.SR_PROXIMITY)) {

                    const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                    addCandidate('PUT', 'Trap Wick Fade', score, 0);

                }

                if (m.lowerWick / m.range >= BotState.config.PA_PIN_TRAP_WICK && m.bullish &&

                    IndicatorEngine.nearSR(cur.close, levels, BotState.config.SR_PROXIMITY)) {

                    const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                    addCandidate('CALL', 'Trap Wick Fade', score, 0);

                }

            }

            // 4. False Break (REACTIVATED)

            if (BotState.config.ENABLE_FALSE_BREAK && BotState.history[pair].m1.length >= BotState.config.BO_LOOKBACK + 1) {

                const look = BotState.history[pair].m1.slice(-(BotState.config.BO_LOOKBACK + 1), -1);

                let mx = -Infinity;

                let mn = Infinity;

                for (let li = 0; li < look.length; li++) {

                    if (look[li].high > mx) mx = look[li].high;

                    if (look[li].low < mn) mn = look[li].low;

                }

                if (cur.high > mx && cur.close < mx) {

                    const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                    addCandidate('PUT', 'False Break Fade', score, 0);

                }

                if (cur.low < mn && cur.close > mn) {

                    const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                    addCandidate('CALL', 'False Break Fade', score, 0);

                }

            }

            // 5. Bollinger Bounce

            if (BotState.config.ENABLE_BOLLINGER && BotState.history[pair].m1.length >= 25) {

                const bb = IndicatorEngine.getBollinger(closes, BotState.config.BB_PERIOD, BotState.config.BB_STD);

                const rsiBB = IndicatorEngine.getRSI(closes, BotState.config.RSI_PERIOD);

                if ((cur.low <= bb.lower || cur.close < bb.lower) && rsiBB < 35) {

                    const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                    addCandidate('CALL', 'Bollinger Bounce', score, 0);

                }

                if ((cur.high >= bb.upper || cur.close > bb.upper) && rsiBB > 65) {

                    const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                    addCandidate('PUT', 'Bollinger Bounce', score, 0);

                }

            }

            // 6. Pin Bar Rejection

            if (BotState.config.ENABLE_PINBAR && m.range > 0 && levels.range > 0) {

                if (m.lowerWick / m.range >= 0.55 && m.bodyRatio <= 0.35 && m.bullish &&

                    IndicatorEngine.nearSR(cur.close, levels, 0.40)) {

                    const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                    addCandidate('CALL', 'Pin Bar Rejection', score, 0);

                }

                if (m.upperWick / m.range >= 0.55 && m.bodyRatio <= 0.35 && !m.bullish &&

                    IndicatorEngine.nearSR(cur.close, levels, 0.40)) {

                    const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                    addCandidate('PUT', 'Pin Bar Rejection', score, 0);

                }

            }

            // 7. Inside Bar

            if (BotState.config.ENABLE_INSIDE_BAR && BotState.history[pair].m1.length >= 2) {

                const prevIB = BotState.history[pair].m1[BotState.history[pair].m1.length - 2];

                if (cur.high <= prevIB.high && cur.low >= prevIB.low && cur.high !== cur.low) {

                    const range = cur.high - cur.low;

                    if (cur.close > prevIB.high || (cur.close - prevIB.low) / range >= 0.8) {

                        const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                        addCandidate('CALL', 'Inside Bar Break', score, 0);

                    } else if (cur.close < prevIB.low || (prevIB.high - cur.close) / range >= 0.8) {

                        const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                        addCandidate('PUT', 'Inside Bar Break', score, 0);

                    }

                }

            }

            // 8. Alligator

            if (BotState.config.ENABLE_ALLIGATOR && BotState.history[pair].s15.length >= BotState.config.ALLIGATOR_MIN_S15) {

                const c15 = BotState.history[pair].s15.map(c => c.close);

                const h15 = BotState.history[pair].s15.map(c => c.high);

                const l15 = BotState.history[pair].s15.map(c => c.low);

                const cJ = IndicatorEngine.getSMAWithShift(c15, 15, 5);

                const cT = IndicatorEngine.getSMAWithShift(c15, 10, 3);

                const cL = IndicatorEngine.getSMAWithShift(c15, 5, 1);

                const pT = IndicatorEngine.getSMAWithShift(c15, 10, 4);

                const pL = IndicatorEngine.getSMAWithShift(c15, 5, 2);

                const pJ = IndicatorEngine.getSMAWithShift(c15, 15, 6);

                const dM = IndicatorEngine.getDeMarker(h15, l15, 15, 0);

                const pD = IndicatorEngine.getDeMarker(h15, l15, 15, 1);

                const mom = IndicatorEngine.getMomentum(c15, 15);

                const ema20 = IndicatorEngine.getEMA(c15, 20);

                if ((pL <= pT || pL <= pJ) && cL > cT && cL > cJ && pD < 70 && dM >= BotState.config.ALLIGATOR_DM_CALL &&

                    mom > 0 && cur.close > ema20) {

                    const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                    addCandidate('CALL', 'Impulso Alligator', score, 0);

                }

                if ((pL >= pT || pL >= pJ) && cL < cT && cL < cJ && pD > 30 && dM <= BotState.config.ALLIGATOR_DM_PUT &&

                    mom < 0 && cur.close < ema20) {

                    const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                    addCandidate('PUT', 'Impulso Alligator', score, 0);

                }

            }

            // 9. Engulfing (with bonus)

            if (BotState.config.ENABLE_ENGULFING && BotState.history[pair].m1.length >= 2) {

                const prevE = BotState.history[pair].m1[BotState.history[pair].m1.length - 2];

                const pE = IndicatorEngine.candleMetrics(prevE);

                const bullE = !pE.bullish && m.bullish && cur.close >= prevE.open && cur.open <= prevE.close &&

                              m.body >= pE.body * BotState.config.PA_ENGULF_BODY_MULT;

                const bearE = pE.bullish && !m.bullish && cur.close <= prevE.open && cur.open >= prevE.close &&

                              m.body >= pE.body * BotState.config.PA_ENGULF_BODY_MULT;

                const sizeOk = m.bodyRatio >= BotState.config.PA_ENGULF_MIN_BODY &&

                               pE.bodyRatio >= BotState.config.PA_ENGULF_PREV_BODY_MIN &&

                               (atr <= 0 || m.range >= atr * BotState.config.PA_ENGULF_RANGE_ATR_MULT);

                function engulfClose(cur, dir) {

                    const r = cur.high - cur.low;

                    if (r <= 0) return false;

                    const thr = BotState.config.PA_ENGULF_CLOSE_EXTREME;

                    return dir === 'CALL' ? (cur.close - cur.low) / r >= thr : (cur.high - cur.close) / r >= thr;

                }

                if (bullE && sizeOk && engulfClose(cur, 'CALL') &&

                    (!BotState.config.PA_ENGULF_REQUIRE_TREND || maUp || IndicatorEngine.m1Bias(BotState.history[pair].m1) === 'UP') &&

                    pE.bodyRatio >= 0.15) {

                    const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                    addCandidate('CALL', 'PA · Engulfing', score, BotState.config.PA_ENGULF_SCORE_BONUS);

                }

                if (bearE && sizeOk && engulfClose(cur, 'PUT') &&

                    (!BotState.config.PA_ENGULF_REQUIRE_TREND || !maUp || IndicatorEngine.m1Bias(BotState.history[pair].m1) === 'DOWN') &&

                    pE.bodyRatio >= 0.15) {

                    const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                    addCandidate('PUT', 'PA · Engulfing', score, BotState.config.PA_ENGULF_SCORE_BONUS);

                }

            }

            // 10. Pullback Fib (with rejection wick)

            if (BotState.config.ENABLE_PULLBACK && levels.range > 0) {

                const rsi = IndicatorEngine.getRSI(closes, BotState.config.RSI_PERIOD);

                function touchClassic(cur, levels, dir) {

                    if (levels.range <= 0) return false;

                    return dir === 'CALL' ? cur.low <= levels.maxH - levels.range * 0.5 :

                                           cur.high >= levels.minL + levels.range * 0.5;

                }

                if (maUp && rsi < BotState.config.PULLBACK_RSI_CALL_MAX &&

                    touchClassic(cur, levels, 'CALL') &&

                    (m.range > 0 && m.lowerWick / m.range >= BotState.config.PULLBACK_REJECT_WICK)) {

                    const score = this.confluenceScore('CALL', BotState.history[pair].m1, levels, true);

                    addCandidate('CALL', 'Pullback Fib', score, 0);

                }

                if (!maUp && rsi > BotState.config.PULLBACK_RSI_PUT_MIN &&

                    touchClassic(cur, levels, 'PUT') &&

                    (m.range > 0 && m.upperWick / m.range >= BotState.config.PULLBACK_REJECT_WICK)) {

                    const score = this.confluenceScore('PUT', BotState.history[pair].m1, levels, true);

                    addCandidate('PUT', 'Pullback Fib', score, 0);

                }

            }

            if (candidates.length === 0) return;

            candidates.sort((a, b) => b.score - a.score);

            const best = candidates[0];

            const maxScore = best.score;

            const topCandidates = candidates.filter(c => c.score === maxScore);

            if (topCandidates.length > 1) {

                best = topCandidates[Math.floor(Math.random() * topCandidates.length)];

            }

            this.updateMotorConsecutive(best.motor);

            TradeManager.triggerSignal(pair, best.dir, time, best.motor, time % 60, best.score);

        }

        static confluenceScore(dir, m1Sim, levels, hasPattern) {

            const closes = m1Sim.map(c => c.close);

            const maUp = IndicatorEngine.getSMA(closes, BotState.config.MA_PERIOD, 0) >

                         IndicatorEngine.getSMA(closes, BotState.config.MA_PERIOD, BotState.config.MA_SLOPE_LOOKBACK);

            const rsi = IndicatorEngine.getRSI(closes, BotState.config.RSI_PERIOD);

            const near = IndicatorEngine.nearSR(m1Sim[m1Sim.length - 1].close, levels, BotState.config.SR_PROXIMITY);

            const trendOK = (dir === 'CALL' && (maUp || IndicatorEngine.m1Bias(m1Sim) === 'UP')) ||

                            (dir === 'PUT' && (!maUp || IndicatorEngine.m1Bias(m1Sim) === 'DOWN'));

            const rsiOK = (dir === 'CALL' && rsi >= 35 && rsi <= 62) ||

                          (dir === 'PUT' && rsi >= 38 && rsi <= 65);

            let score = hasPattern ? 1 : 0;

            if (trendOK) score++;

            if (rsiOK) score++;

            if (near) score++;

            return {

                total: score,

                trend: trendOK,

                rsi: rsiOK,

                sr: near,

                rsiValue: rsi

            };

        }

        static isMotorPaused(motor) {

            return BotState.motorPausedUntil[motor] && Date.now() < BotState.motorPausedUntil[motor];

        }

        static updateMotorConsecutive(motor) {

            if (motor === BotState.lastMotorUsed) {

                BotState.motorConsecutiveCount[motor] = (BotState.motorConsecutiveCount[motor] || 0) + 1;

            } else {

                BotState.motorConsecutiveCount = {};

                BotState.motorConsecutiveCount[motor] = 1;

            }

            BotState.lastMotorUsed = motor;

            if (BotState.motorConsecutiveCount[motor] >= BotState.config.REPETITION_PAUSE_LIMIT) {

                BotState.motorPausedUntil[motor] = Date.now() + BotState.config.REPETITION_PAUSE_MINUTES * 60000;

                DataManager.uiLog('⏸️ Auto-pausa: ' + motor + ' por ' + BotState.config.REPETITION_PAUSE_MINUTES + ' min (' +

                                 BotState.config.REPETITION_PAUSE_LIMIT + ' señales seguidas)');

                BotState.motorConsecutiveCount = {};

            }

        }

        static getPairShare(pairLabel) {

            if (!BotState.pairRecentSignals[pairLabel]) return 0;

            const cutoff = Date.now() - BotState.config.PAIR_DIVERSITY_WINDOW * 60000;

            const recent = BotState.pairRecentSignals[pairLabel].filter(ts => ts >= cutoff);

            BotState.pairRecentSignals[pairLabel] = recent;

            let total = 0;

            for (const p in BotState.pairRecentSignals) {

                if (BotState.pairRecentSignals.hasOwnProperty(p)) {

                    const valid = BotState.pairRecentSignals[p].filter(ts => ts >= cutoff);

                    total += valid.length;

                }

            }

            if (total === 0) return 0;

            return recent.length / total;

        }

    }

    // ==================== TRADE MANAGER ====================

    class TradeManager {

        static triggerSignal(pair, direction, time, motor, alertSec, confScore) {

            const nowMin = Math.floor(time / 60);

            if (nowMin - (BotState.lastSignalMinuteByPair[pair] || 0) < BotState.config.COOLDOWN_MINUTES_PER_PAIR) return false;

            if (motor === 'Pullback Fib') {

                if (nowMin - (BotState.lastPullbackMinuteByPair[pair] || 0) < BotState.config.PULLBACK_COOLDOWN_MIN) return false;

                BotState.lastPullbackMinuteByPair[pair] = nowMin;

            }

            const nowHour = Math.floor(Date.now() / 3600000);

            if (nowHour !== BotState.lastHourReset) {

                BotState.signalsThisHour = 0;

                BotState.signalsPerPairHour = {};

                BotState.lastHourReset = nowHour;

            }

            if (BotState.signalsThisHour >= BotState.config.MAX_SIGNALS_PER_HOUR) return false;

            if ((BotState.signalsPerPairHour[pair] || 0) >= BotState.config.MAX_SIGNALS_PER_PAIR_HOUR) return false;

            BotState.signalsToday++;

            BotState.signalsThisHour++;

            BotState.signalsPerPairHour[pair] = (BotState.signalsPerPairHour[pair] || 0) + 1;

            BotState.lastSignalMinuteByPair[pair] = nowMin;

            if (!BotState.statsByMotor[motor]) {

                BotState.statsByMotor[motor] = { w: 0, wG1: 0, l: 0 };

            }

            const entryTs = (nowMin + 1) * 60;

            const tDisp = DataManager.getDisplayTime(entryTs);

            BotState.pendingTrades[pair] = {

                direction,

                entryTimestamp: entryTs,

                expiryTimestamp: entryTs + BotState.config.EXPIRY_TIME_SEC,

                timeStr: tDisp.hm,

                motor,

                attempt: 1,

                alertSec: alertSec

            };

            BotState.lastSignalUI = {

                pair: DataManager.formatPairDisplay(pair),

                dir: direction === 'CALL' ? 'CALL' : 'PUT',

                motor,

                hm: tDisp.hm

            };

            if (BotState.config.AUTOTRADE_ENABLED && BotState.config.MULTI_PAR_ENABLED) {

                const signalNormalized = pair.toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

                const currentVisible = DataManager.getVisiblePairFromUI();

                if (currentVisible !== signalNormalized) {

                    DataManager.switchToFavoritePair(pair);

                }

            }

            const isCall = direction === 'CALL';

            const payout = BotState.pairPayouts[pair] || 85;

            const confStr = confScore ? ' · conf ' + confScore + ' · seg ' + alertSec : '';

            // Send Telegram message with force flag to ensure delivery

            DataManager.sendTelegramMessage('💎 LIVE Edge💎\n🌐 Zona Horaria: UTC-1\n📊 DIVISA: ' +

                                          DataManager.formatPairDisplay(pair) + '\n' +

                                          (isCall ? '🟩' : '🟥') + ' DIRECCIÓN: ' +

                                          (isCall ? 'CALL' : 'PUT') + '\n⏰ HORA DE ENTRADA: ' +

                                          tDisp.hm + '\n⏱ TIEMPO: 1 minuto (M1)\n🧠 ' +

                                          motor + confStr, true);

            DataManager.uiLog('SEÑAL ' + DataManager.formatPairDisplay(pair) + ' ' + direction + ' · ' + motor + confStr);

            this.recordPairSignal(pair);

            UIController.refreshPanelLive();

            this.autoKillCheck();

            return true;

        }

        static resolveTrade(pairLabel, trade, price, tickTime) {

            const motor = trade.motor;

            const dir = trade.direction;

            const attempt = trade.attempt || 1;

            const disp = DataManager.formatPairDisplay(pairLabel);

            const hm = trade.timeStr || DataManager.getDisplayTime(tickTime).hm;

            if (!BotState.statsByMotor[motor]) {

                BotState.statsByMotor[motor] = { w: 0, wG1: 0, l: 0 };

            }

            if ((dir === 'CALL' && price > trade.entryPrice) ||

                (dir === 'PUT' && price < trade.entryPrice)) {

                if (attempt === 1) {

                    BotState.statsByMotor[motor].w++;

                    BotState.tradeHistory.push({ result: 'WIN', motor });

                    BotState.sessionLog.push({ pair: disp, hm, win: true, g1: false, dateDM: DataManager.getDisplayTime(tickTime).dateDM });

                } else {

                    BotState.statsByMotor[motor].wG1++;

                    BotState.tradeHistory.push({ result: 'WIN_G1', motor });

                    BotState.sessionLog.push({ pair: disp, hm, win: true, g1: true, dateDM: DataManager.getDisplayTime(tickTime).dateDM });

                }

                // Force send Telegram message for win

                DataManager.sendTelegramMessage('✅ <b>WIN</b>' + (attempt === 2 ? ' (G1)' : '') + '\n' +

                                              hm + ' | ' + disp + '\n🧠 ' + motor, true);

                DataManager.uiLog('WIN' + (attempt === 2 ? ' G1' : '') + ' ' + disp + ' · ' + motor);

                this.updateMotorRecent(motor, true);

                delete BotState.activeTrades[pairLabel];

                if (attempt === 1 || attempt === 2) {

                    BotState.cyclesToday++;

                }

                this.maybeSummary();

                UIController.refreshPanelLive();

                return;

            }

            // LOSS: record data

            const curCandle = BotState.candleState[pairLabel]?.m1;

            const curMetrics = curCandle ? IndicatorEngine.candleMetrics(curCandle) : {};

            BotState.lossLog.push({

                date: DataManager.getDisplayTime(tickTime).dateDM,

                time: DataManager.getDisplayTime(tickTime).hm,

                pair: disp,

                motor: motor,

                dir: dir,

                open: curCandle?.open?.toFixed(5) || '',

                close: curCandle?.close?.toFixed(5) || '',

                high: curCandle?.high?.toFixed(5) || '',

                low: curCandle?.low?.toFixed(5) || '',

                upperWick: curMetrics.upperWick?.toFixed(5) || '',

                lowerWick: curMetrics.lowerWick?.toFixed(5) || '',

                body: curMetrics.body?.toFixed(5) || '',

                rsi: IndicatorEngine.getRSI((BotState.history[pairLabel]?.m1 || []).map(c => c.close).concat([curCandle?.close || 0]), BotState.config.RSI_PERIOD),

                payout: BotState.pairPayouts[pairLabel] || 85,

                ticks: BotState.tickCountByPair[pairLabel] || 0

            });

            const payout = BotState.pairPayouts[pairLabel] || 85;

            const allowMartingale = BotState.config.MARTINGALE_ENABLED && payout >= BotState.config.MIN_PAYOUT_FOR_MARTINGALE;

            if (attempt === 1 && allowMartingale && BotState.config.MARTINGALE_STEPS >= 1) {

                const gTs = Math.floor(tickTime);

                const gExp = gTs + BotState.config.EXPIRY_TIME_SEC;

                BotState.activeTrades[pairLabel] = {

                    direction: dir,

                    entryPrice: price,

                    entryTimestamp: gTs,

                    expiryTimestamp: gExp,

                    timeStr: DataManager.getDisplayTime(gTs).hm,

                    motor,

                    attempt: 2

                };

                if (BotState.config.AUTOTRADE_ENABLED) {

                    const visiblePair = DataManager.getVisiblePairFromUI();

                    const signalPairNormalized = pairLabel.toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

                    if (visiblePair === signalPairNormalized) {

                        DataManager.autoClickButton(dir, true);

                    } else if (BotState.config.MULTI_PAR_ENABLED && DataManager.switchToFavoritePair(pairLabel)) {

                        setTimeout(() => DataManager.autoClickButton(dir, true), 400);

                    } else {

                        DataManager.uiLog('⏭️ AutoTrade Gale: par no coincide');

                    }

                }

                // Force send Telegram message for gale

                DataManager.sendTelegramMessage('🌀 GALE 1\n' + disp + '\n' +

                                              (dir === 'CALL' ? '🟩' : '🟥') + ' ' +

                                              (dir === 'CALL' ? 'CALL' : 'PUT') + ' · ' +

                                              motor + '\n⏰ Exp ~' + DataManager.getDisplayTime(gExp).hm + ' (UTC-1)', true);

                DataManager.uiLog('GALE1 ' + disp);

                UIController.refreshPanelLive();

                return;

            }

            BotState.statsByMotor[motor].l++;

            BotState.tradeHistory.push({ result: 'LOSS', motor });

            BotState.sessionLog.push({ pair: disp, hm, win: false, g1: false, dateDM: DataManager.getDisplayTime(tickTime).dateDM });

            // Force send Telegram message for loss

            DataManager.sendTelegramMessage('❌ <b>LOSS</b>' + (attempt === 2 ? ' (G1)' : '') + '\n' +

                                          hm + ' | ' + disp + '\n🧠 ' + motor, true);

            DataManager.uiLog('LOSS ' + disp + ' · ' + motor);

            this.updateMotorRecent(motor, false);

            delete BotState.activeTrades[pairLabel];

            if (attempt === 1 || attempt === 2) {

                BotState.cyclesToday++;

            }

            this.maybeSummary();

            UIController.refreshPanelLive();

        }

        static updateMotorRecent(motor, isWin) {

            if (!BotState.motorRecentResults[motor]) {

                BotState.motorRecentResults[motor] = [];

            }

            BotState.motorRecentResults[motor].push(isWin);

            while (BotState.motorRecentResults[motor].length > BotState.config.MOTOR_CONFIDENCE_WINDOW) {

                BotState.motorRecentResults[motor].shift();

            }

        }

        static recordPairSignal(pairLabel) {

            if (!BotState.pairRecentSignals[pairLabel]) {

                BotState.pairRecentSignals[pairLabel] = [];

            }

            BotState.pairRecentSignals[pairLabel].push(Date.now());

            const cutoff = Date.now() - BotState.config.PAIR_DIVERSITY_WINDOW * 60000;

            while (BotState.pairRecentSignals[pairLabel].length &&

                   BotState.pairRecentSignals[pairLabel][0] < cutoff) {

                BotState.pairRecentSignals[pairLabel].shift();

            }

        }

        static maybeSummary() {

            if (BotState.sessionLog.length && BotState.sessionLog.length % BotState.config.SUMMARY_EVERY_N === 0) {

                DataManager.sendTelegramMessage(this.buildSessionSummary());

            }

        }

        static buildSessionSummary() {

            const dateStr = BotState.sessionLog.length ?

                           BotState.sessionLog[0].dateDM :

                           DataManager.getDisplayTime(Math.floor(DataManager.getAdjustedTime())).dateDM;

            const lines = ['📋 <b>RESUMEN VIP Glass v5.9 PRO (' + dateStr + ')</b> 📋', '━━━━━━━━━━━━━━━━━━'];

            let wins = 0;

            let losses = 0;

            for (let i = 0; i < BotState.sessionLog.length; i++) {

                const o = BotState.sessionLog[i];

                if (o.win) {

                    wins++;

                    lines.push('✅ ' + o.hm + ' | ' + o.pair + ' ➔ ' + (o.g1 ? 'WIN G1' : 'WIN'));

                } else {

                    losses++;

                    lines.push('❌ ' + o.hm + ' | ' + o.pair + ' ➔ LOSS');

                }

            }

            const tot = wins + losses;

            const wr = tot ? Math.round(wins / tot * 100) : 0;

            lines.push('━━━━━━━━━━━━━━━━━━', '📊 <b>BALANCE</b>', '🏆 ' + String(wins).padStart(2, '0') + 'W | 🛑 ' +

                      String(losses).padStart(2, '0') + 'L', '📈 WR: <b>' + wr + '%</b>', '🎯 ' +

                      BotState.cyclesToday + '/' + BotState.config.MAX_SIGNALS_SESSION + ' ciclos');

            lines.push('🧠 <b>Por motor:</b>');

            for (const m in BotState.statsByMotor) {

                const s = BotState.statsByMotor[m];

                const totalM = s.w + s.wG1 + s.l;

                if (totalM > 0) lines.push(m + ': ' + (s.w + s.wG1) + 'W / ' + s.l + 'L');

            }

            return lines.join('\n');

        }

        static autoKillCheck() {

            if (!BotState.config.AUTO_KILL_ENABLED) return;

            const motors = [

                { key: 'ENABLE_BOLLINGER', name: 'Bollinger Bounce' },

                { key: 'ENABLE_PINBAR', name: 'Pin Bar Rejection' },

                { key: 'ENABLE_INSIDE_BAR', name: 'Inside Bar Break' },

                { key: 'ENABLE_ALLIGATOR', name: 'Impulso Alligator' },

                { key: 'ENABLE_GAP_FILL', name: 'Gap Fill' },

                { key: 'ENABLE_PULLBACK', name: 'Pullback Fib' },

                { key: 'ENABLE_ENGULFING', name: 'PA · Engulfing' },

                { key: 'ENABLE_GAP', name: 'PA · Gap' },

                { key: 'ENABLE_TRAP_WICK', name: 'Trap Wick Fade' },

                { key: 'ENABLE_FALSE_BREAK', name: 'False Break Fade' }

            ];

            const windowSize = BotState.config.AUTO_KILL_WINDOW;

            const minWR = BotState.config.AUTO_KILL_MIN_WR;

            for (let i = 0; i < motors.length; i++) {

                const m = motors[i];

                if (!BotState.config[m.key]) continue;

                const recent = BotState.motorRecentResults[m.name] || [];

                if (recent.length < windowSize) continue;

                let wins = 0;

                for (let j = recent.length - windowSize; j < recent.length; j++) {

                    if (recent[j]) wins++;

                }

                const wr = wins / windowSize;

                if (wr < minWR) {

                    BotState.config[m.key] = false;

                    DataManager.uiLog('💀 Auto-Kill: ' + m.name + ' desactivado (WR ' + (wr * 100).toFixed(0) + '%)');

                }

            }

            DataManager.savePrefs();

            UIController.applySavedPrefsToUi();

        }

    }


    // ==================== DATA MANAGER ====================

    class DataManager {

        static initialize() {

            BotState.history = {};

            BotState.candleState = {};

            BotState.tickCountByPair = {};

        }

        static processTick(pair, time, price) {

            try {

                if (typeof pair !== 'string' || !isFinite(time) || !isFinite(price)) return;

                if (BotState.serverTimeOffset === 0) {

                    BotState.serverTimeOffset = time - Math.floor(Date.now() / 1000);

                }

                const pairLabel = normalizePairFromTick(pair);

                this.registerPair(pairLabel);

                this.resetInactivityTimer();

                const block60 = Math.floor(time / 60);

                if (!BotState.tickCountByPair[pairLabel] ||

                    BotState.candleState[pairLabel]?.m1?.block !== block60) {

                    BotState.tickCountByPair[pairLabel] = 1;

                } else {

                    BotState.tickCountByPair[pairLabel]++;

                }

                // Handle expired trades

                if (BotState.activeTrades[pairLabel] && time >= BotState.activeTrades[pairLabel].expiryTimestamp) {

                    TradeManager.resolveTrade(pairLabel, BotState.activeTrades[pairLabel], price, time);

                }

                // Handle pending trades

                if (BotState.pendingTrades[pairLabel] && !BotState.activeTrades[pairLabel]) {

                    const pend = BotState.pendingTrades[pairLabel];

                    if (time >= pend.entryTimestamp) {

                        if (time - pend.entryTimestamp > 8) {

                            console.log('Pending expired without entry:', pairLabel);

                            delete BotState.pendingTrades[pairLabel];

                        } else {

                            BotState.activeTrades[pairLabel] = {

                                direction: pend.direction,

                                entryPrice: price,

                                entryTimestamp: pend.entryTimestamp,

                                expiryTimestamp: pend.expiryTimestamp,

                                timeStr: pend.timeStr,

                                motor: pend.motor,

                                attempt: 1,

                                alertSec: pend.alertSec

                            };

                            delete BotState.pendingTrades[pairLabel];

                            console.log('Entry confirmed:', pairLabel);

                            if (BotState.config.AUTOTRADE_ENABLED) {

                                this.handleAutoTrade(pairLabel, pend.direction);

                            }

                        }

                    } else if (pend.entryTimestamp - time > 90) {

                        delete BotState.pendingTrades[pairLabel];

                    }

                }

                if (!BotState.history[pairLabel]) {

                    BotState.history[pairLabel] = { s15: [], m1: [], m5: [] };

                }

                const block15 = Math.floor(time / 15);

                const block300 = Math.floor(time / 300);

                if (!BotState.candleState[pairLabel]) {

                    BotState.candleState[pairLabel] = {

                        s15: { block: block15, open: price, high: price, low: price, close: price },

                        m1: { block: block60, open: price, high: price, low: price, close: price },

                        m5: { block: block300, open: price, high: price, low: price, close: price }

                    };

                }

                const state = BotState.candleState[pairLabel];

                function roll(tf, block, key, max) {

                    if (state[tf].block !== block) {

                        BotState.history[pairLabel][key].push({

                            open: state[tf].open,

                            high: state[tf].high,

                            low: state[tf].low,

                            close: state[tf].close

                        });

                        if (BotState.history[pairLabel][key].length > max) {

                            BotState.history[pairLabel][key].shift();

                        }

                        state[tf] = {

                            block: block,

                            open: price,

                            high: price,

                            low: price,

                            close: price

                        };

                        if (tf === 'm1') {

                            BotState.tickCountByPair[pairLabel] = 1;

                        }

                    } else {

                        state[tf].high = Math.max(state[tf].high, price);

                        state[tf].low = Math.min(state[tf].low, price);

                        state[tf].close = price;

                    }

                }

                roll('s15', block15, 's15', 80);

                roll('m1', block60, 'm1', 40);

                roll('m5', block300, 'm5', 12);

                // Evaluate signals if conditions met

                if (this.canEvaluate(pairLabel, time)) {

                    this.evaluateSignals(pairLabel, time);

                }

            } catch (err) {

                console.error('[VIP processTick]', err);

                this.uiLog('ERR processTick');

            }

        }

        static canEvaluate(pairLabel, time) {

            if (!BotState.config.BOT_RUNNING || BotState.cyclesToday >= BotState.config.MAX_SIGNALS_SESSION) {

                return false;

            }

            if (BotState.config.OPERATION_MODE === 'normal' && this.hasOpenCycle()) {

                return false;

            }

            if (BotState.activeTrades[pairLabel] || BotState.pendingTrades[pairLabel]) {

                return false;

            }

            if (!this.isPairEnabled(pairLabel)) {

                return false;

            }

            const secInMin = time % 60;

            if (BotState.config.OPERATION_MODE !== 'test' &&

                (secInMin < BotState.config.EVAL_SEC_START || secInMin > BotState.config.EVAL_SEC_END)) {

                return false;

            }

            return true;

        }

        static evaluateSignals(pairLabel, time) {

            StrategyEngine.evaluateAll(pairLabel, time);

        }

        static handleAutoTrade(pairLabel, direction) {

            if (BotState.config.AUTOTRADE_ENABLED) {

                const visiblePair = this.getVisiblePairFromUI();

                const signalPairNormalized = pairLabel.toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

                if (visiblePair === signalPairNormalized) {

                    this.autoClickButton(direction, false);

                } else if (BotState.config.MULTI_PAR_ENABLED) {

                    if (this.switchToFavoritePair(pairLabel)) {

                        setTimeout(() => this.autoClickButton(direction, false), 300);

                    }

                }

            }

        }

        static getVisiblePairFromUI() {

            const selectors = [

                '[class*="current-symbol"]',

                '[class*="currentSymbol"]',

                '[class*="pair-name"]',

                '[class*="asset-name"]',

                '[class*="symbol-name"]',

                '.pair',

                '[data-symbol]'

            ];

            for (let i = 0; i < selectors.length; i++) {

                const el = document.querySelector(selectors[i]);

                if (el) {

                    const txt = (el.getAttribute('data-symbol') || el.textContent || '').trim();

                    if (txt.length >= 6) {

                        return txt.toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

                    }

                }

            }

            return '';

        }

        static autoClickButton(direction, doubleClick) {

            let items = document.querySelectorAll('.switch-state-block__item');

            if (items.length >= 2) {

                const btn = direction === 'CALL' ? items[0] : items[1];

                if (btn && typeof btn.click === 'function') {

                    btn.click();

                    if (doubleClick) {

                        setTimeout(() => btn.click(), 80);

                    }

                    return true;

                }

            }

            const todos = document.querySelectorAll('button, [role="button"], div');

            for (let i = 0; i < todos.length; i++) {

                const rect = todos[i].getBoundingClientRect();

                if (rect.width > 80 && rect.height > 30 && rect.top > window.innerHeight * 0.4) {

                    if ((direction === 'CALL' && rect.left < window.innerWidth / 2) ||

                        (direction === 'PUT' && rect.left > window.innerWidth / 2)) {

                        todos[i].click();

                        if (doubleClick) {

                            setTimeout(() => todos[i].click(), 80);

                        }

                        return true;

                    }

                }

            }

            return false;

        }

        static switchToFavoritePair(targetPairLabel) {

            const targetNormalized = normalizePairFromTick(targetPairLabel).toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

            const labels = document.querySelectorAll('.assets-favorites-item__label');

            for (let i = 0; i < labels.length; i++) {

                const label = labels[i];

                const txt = (label.textContent || '').trim().toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

                if (txt === targetNormalized) {

                    const item = label.closest('.assets-favorites-item');

                    if (item && typeof item.click === 'function') {

                        item.click();

                        return true;

                    }

                }

            }

            const alistItems = document.querySelectorAll('.alist__item');

            for (let j = 0; j < alistItems.length; j++) {

                const alistText = (alistItems[j].textContent || '').trim().toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

                if (alistText.indexOf(targetNormalized) !== -1) {

                    alistItems[j].click();

                    return true;

                }

            }

            return false;

        }

        static registerPair(pairLabel) {

            if (!BotState.pairWatch[pairLabel]) {

                const saved = this.loadPairStates();

                const enabled = true;

                const paused = false;

                if (saved[pairLabel]) {

                    const savedState = saved[pairLabel];

                    if (savedState.enabled !== undefined) enabled = savedState.enabled !== false;

                    if (savedState.paused !== undefined) paused = savedState.paused === true;

                }

                BotState.pairWatch[pairLabel] = { enabled: enabled, paused: paused, ticks: 0 };

                this.uiLog('Par detectado: ' + this.formatPairDisplay(pairLabel));

                UIController.renderPairList();

            }

            BotState.pairWatch[pairLabel].ticks += 1;

        }

        static isPairEnabled(pairLabel) {

            if (BotState.deadZonePauseUntil[pairLabel] && Date.now() < BotState.deadZonePauseUntil[pairLabel]) {

                return false;

            }

            if (!BotState.pairWatch[pairLabel]) return true;

            return BotState.pairWatch[pairLabel].enabled !== false && BotState.pairWatch[pairLabel].paused !== true;

        }

        static resetInactivityTimer() {

            BotState.lastTickTime = Date.now();

            if (BotState.inactivityTimer) clearTimeout(BotState.inactivityTimer);

            BotState.inactivityTimer = setTimeout(() => {

                if (BotState.config.BOT_RUNNING && Date.now() - BotState.lastTickTime > 120000) {

                    BotState.config.BOT_RUNNING = false;

                    this.uiLog('⚠️ Bot pausado por inactividad (2 min sin ticks)');

                    UIController.refreshPanelLive();

                    this.savePrefs();

                    this.sendTelegramMessage('⚠️ Bot pausado automáticamente por inactividad (>2 min sin datos)');

                }

            }, 120000);

        }

        static hasOpenCycle() {

            for (const k in BotState.pendingTrades) {

                if (BotState.pendingTrades.hasOwnProperty(k)) return true;

            }

            for (const k in BotState.activeTrades) {

                if (BotState.activeTrades.hasOwnProperty(k)) return true;

            }

            return false;

        }

        static uiLog(msg) {

            const t = this.getDisplayTime(Math.floor(Date.now() / 1000)).hms;

            BotState.localLog.push({ t: t, msg: msg });

            if (BotState.localLog.length > BotState.config.LOG_MAX_LINES) BotState.localLog.shift();

            try {

                console.log('[VIP]', msg);

            } catch (e) {}

            UIController.renderPanelLog();

        }

        static sendTelegramMessage(text, forceSend = false) {

            if (!BotState.config.TELEGRAM_ENABLED && !forceSend) return;

            // Add a unique identifier to ensure message uniqueness

            const messageId = Date.now() + Math.random().toString(36).substr(2, 9);



            try {

                GM_xmlhttpRequest({

                    method: 'POST',

                    url: 'https://api.telegram.org/bot' + BotState.config.TELEGRAM_TOKEN + '/sendMessage',

                    headers: { 'Content-Type': 'application/json' },

                    data: JSON.stringify({

                        chat_id: BotState.config.TELEGRAM_CHAT_ID,

                        text: text + `\n<MessageId:${messageId}>`,

                        parse_mode: 'HTML'

                    }),

                    onload: function(response) {

                        // Log successful message send

                        if (response.status === 200) {

                            console.log('Telegram message sent successfully:', messageId);

                        } else {

                            console.warn('Telegram message failed:', response.status, response.responseText);

                        }

                    },

                    onerror: function(error) {

                        console.error('Telegram API error:', error);

                        this.uiLog('TG error: ' + error.message);

                    },

                    ontimeout: function() {

                        console.error('Telegram API timeout');

                        this.uiLog('TG timeout');

                    }

                });

            } catch (e) {

                console.error('Exception in sendTelegramMessage:', e);

                this.uiLog('TG exception: ' + e.message);

            }

        }

        static getDisplayTime(ts) {

            const d = new Date(ts * 1000);

            const utc = d.getTime() + d.getTimezoneOffset() * 60000;

            const nd = new Date(utc + BotState.config.DISPLAY_UTC_OFFSET_MIN * 60000);

            function z(n) {

                return String(n).padStart(2, '0');

            }

            return {

                hm: z(nd.getHours()) + ':' + z(nd.getMinutes()),

                hms: z(nd.getHours()) + ':' + z(nd.getMinutes()) + ':' + z(nd.getSeconds()),

                dateDM: z(nd.getDate()) + '/' + z(nd.getMonth() + 1)

            };

        }

        static formatPairDisplay(pair) {

            const s = normalizePairFromTick(pair);

            const otc = /OTC/i.test(s);

            const m = s.match(/^([A-Z]{3})\s*([A-Z]{3})/i);

            if (m) return m[1] + '/' + m[2] + (otc ? ' OTC' : '');

            m = s.match(/^([A-Z]{6})/i);

            if (m) return m[1].slice(0, 3) + '/' + m[1].slice(3, 6) + (otc ? ' OTC' : '');

            return s;

        }

        static normalizePairFromTick(pair) {

            return String(pair).toUpperCase().replace(/_OTC/gi, ' OTC').replace(/_/g, ' ').replace(/\s+/g, ' ').trim();

        }

        static loadPairStates() {

            try {

                return JSON.parse(localStorage.getItem(PAIR_STATE_KEY) || '{}');

            } catch (e) {

                return {};

            }

        }


        static makeDraggable(panel, handle) {

            let dragging = false;

            let ox = 0;

            let oy = 0;

            handle.addEventListener('mousedown', function (e) {

                if (e.button !== 0 || e.target.closest('.po-vip-log, .po-vip-pairs, .pills-grid')) return;

                dragging = true;

                const r = panel.getBoundingClientRect();

                ox = e.clientX - r.left;

                oy = e.clientY - r.top;

                panel.style.right = 'auto';

                panel.style.left = r.left + 'px';

                panel.style.top = r.top + 'px';

                e.preventDefault();

            });

            window.addEventListener('mousemove', function (e) {

                if (!dragging) return;

                panel.style.left = Math.min(window.innerWidth - 48, Math.max(0, e.clientX - ox)) + 'px';

                panel.style.top = Math.min(window.innerHeight - 40, Math.max(0, e.clientY - oy)) + 'px';

            });

            window.addEventListener('mouseup', function () {

                if (dragging) {

                    dragging = false;

                    DataManager.savePrefs();

                }

            });

        }


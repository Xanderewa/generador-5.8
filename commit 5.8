        var rsi=getRSI(closes,CONFIG.RSI_PERIOD);

        var near=nearSR(m1Sim[m1Sim.length-1].close,levels,CONFIG.SR_PROXIMITY);

        var trendOK = (dir==='CALL' && (maUp||m1Bias(m1Sim)==='UP')) || (dir==='PUT' && (!maUp||m1Bias(m1Sim)==='DOWN'));


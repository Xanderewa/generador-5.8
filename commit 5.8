            motorConsecutiveCount[motor] = (motorConsecutiveCount[motor] || 0) + 1;

        } else {

            motorConsecutiveCount = {};

            motorConsecutiveCount[motor] = 1;

        }

        lastMotorUsed = motor;

        if (motorConsecutiveCount[motor] >= CONFIG.REPETITION_PAUSE_LIMIT) {

            motorPausedUntil[motor] = Date.now() + CONFIG.REPETITION_PAUSE_MINUTES * 60000;

            uiLog('⏸️ Auto‑pausa: ' + motor + ' por ' + CONFIG.REPETITION_PAUSE_MINUTES + ' min (' + CONFIG.REPETITION_PAUSE_LIMIT + ' señales seguidas)');

            motorConsecutiveCount = {};

        }

    }


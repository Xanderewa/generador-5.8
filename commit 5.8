    // ==================== PREFS ====================

    function loadPrefs() {

        try { var raw = localStorage.getItem(STORAGE_KEY); return raw ? JSON.parse(raw) : null; } catch (e) { return null; }

    }

    function savePrefs() {

        try {

            localStorage.setItem(STORAGE_KEY, JSON.stringify({

                bot: CONFIG.BOT_RUNNING,

                tg: CONFIG.TELEGRAM_ENABLED,

                mode: CONFIG.OPERATION_MODE,

                autoTrade: CONFIG.AUTOTRADE_ENABLED,

                multiPar: CONFIG.MULTI_PAR_ENABLED,

                martingale: CONFIG.MARTINGALE_ENABLED,

                autoKill: CONFIG.AUTO_KILL_ENABLED,

                minPayout: CONFIG.MIN_PAYOUT,


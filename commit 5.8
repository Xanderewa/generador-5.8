    // ==================== FUNCIONES INTELIGENTES ====================

    function autoTop3() {

        var motorNames = [

            { key: 'ENABLE_BOLLINGER', name: 'Bollinger Bounce' }, { key: 'ENABLE_PINBAR', name: 'Pin Bar Rejection' }, { key: 'ENABLE_INSIDE_BAR', name: 'Inside Bar Break' },

            { key: 'ENABLE_ALLIGATOR', name: 'Impulso Alligator' }, { key: 'ENABLE_GAP_FILL', name: 'Gap Fill' }, { key: 'ENABLE_PULLBACK', name: 'Pullback Fib' },

            { key: 'ENABLE_ENGULFING', name: 'PA · Engulfing' }, { key: 'ENABLE_GAP', name: 'PA · Gap' }, { key: 'ENABLE_TRAP_WICK', name: 'Trap Wick Fade' },

            { key: 'ENABLE_FALSE_BREAK', name: 'False Break Fade' }

        ];

        var valid = [];

        for (var i = 0; i < motorNames.length; i++) {

            var m = motorNames[i]; var stats = statsByMotor[m.name];

            if (stats && (stats.w + stats.wG1 + stats.l) >= 5) { var wr = (stats.w + stats.wG1) / (stats.w + stats.wG1 + stats.l); valid.push({ key: m.key, wr: wr }); }

        }

        valid.sort(function(a, b) { return b.wr - a.wr; });

        var top3Keys = valid.slice(0, 3).map(function(x) { return x.key; });

        for (var j = 0; j < motorNames.length; j++) CONFIG[motorNames[j].key] = false;

        for (var k = 0; k < top3Keys.length; k++) CONFIG[top3Keys[k]] = true;

        uiLog('⚡ Auto-Top 3: ' + top3Keys.join(', '));

        savePrefs(); applySavedPrefsToUi();

    }

    function autoKillCheck() {

        if (!CONFIG.AUTO_KILL_ENABLED) return;

        var motors = [

            { key: 'ENABLE_BOLLINGER', name: 'Bollinger Bounce' }, { key: 'ENABLE_PINBAR', name: 'Pin Bar Rejection' }, { key: 'ENABLE_INSIDE_BAR', name: 'Inside Bar Break' },

            { key: 'ENABLE_ALLIGATOR', name: 'Impulso Alligator' }, { key: 'ENABLE_GAP_FILL', name: 'Gap Fill' }, { key: 'ENABLE_PULLBACK', name: 'Pullback Fib' },

            { key: 'ENABLE_ENGULFING', name: 'PA · Engulfing' }, { key: 'ENABLE_GAP', name: 'PA · Gap' }, { key: 'ENABLE_TRAP_WICK', name: 'Trap Wick Fade' },

            { key: 'ENABLE_FALSE_BREAK', name: 'False Break Fade' }

        ];

        var windowSize = CONFIG.AUTO_KILL_WINDOW, minWR = CONFIG.AUTO_KILL_MIN_WR;

        for (var i = 0; i < motors.length; i++) {

            var m = motors[i]; if (!CONFIG[m.key]) continue;

            var recent = motorRecentResults[m.name] || []; if (recent.length < windowSize) continue;

            var wins = 0; for (var j = recent.length - windowSize; j < recent.length; j++) { if (recent[j]) wins++; }

            var wr = wins / windowSize;

            if (wr < minWR) { CONFIG[m.key] = false; uiLog('💀 Auto-Kill: ' + m.name + ' desactivado (WR ' + (wr*100).toFixed(0) + '%)'); }

        }

        savePrefs(); applySavedPrefsToUi();

    }

    function exportLossCSV() {

        if (lossLog.length === 0) {

            uiLog('No hay datos de pérdidas para exportar');

            return;

        }

        var csvContent = "data:text/csv;charset=utf-8,";

        csvContent += "Fecha,Hora,Par,Motor,Dirección,Apertura,Cierre,Máximo,Mínimo,Mecha Sup,Mecha Inf,Cuerpo,RSI,Payout,Ticks\n";

        for (var i = 0; i < lossLog.length; i++) {

            var l = lossLog[i];

            var row = [

                l.date, l.time, l.pair, l.motor, l.dir,

                l.open, l.close, l.high, l.low,

                l.upperWick, l.lowerWick, l.body,

                l.rsi, l.payout, l.ticks

            ].join(',');

            csvContent += row + "\n";

        }

        var encodedUri = encodeURI(csvContent);

        var link = document.createElement("a");

        link.setAttribute("href", encodedUri);

        link.setAttribute("download", "losses_" + new Date().toISOString().slice(0,10) + ".csv");

        document.body.appendChild(link);

        link.click();

        document.body.removeChild(link);

        uiLog('📥 CSV exportado (' + lossLog.length + ' pérdidas)');

    }


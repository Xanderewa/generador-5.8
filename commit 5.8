        level = String(level || 'weak').toLowerCase();

        if (!PULLBACK_PRESETS[level]) level = 'weak';

        CONFIG.PULLBACK_LEVEL = level;

        var p = PULLBACK_PRESETS[level], k;

        for (k in p) if (Object.prototype.hasOwnProperty.call(p, k)) CONFIG[k] = p[k];

    }


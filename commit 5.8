                eng: CONFIG.ENGULF_LEVEL,

                enables: {

                    ENABLE_BOLLINGER: CONFIG.ENABLE_BOLLINGER,

                    ENABLE_PINBAR: CONFIG.ENABLE_PINBAR,

                    ENABLE_INSIDE_BAR: CONFIG.ENABLE_INSIDE_BAR,

                    ENABLE_ALLIGATOR: CONFIG.ENABLE_ALLIGATOR,

                    ENABLE_GAP_FILL: CONFIG.ENABLE_GAP_FILL,

                    ENABLE_PULLBACK: CONFIG.ENABLE_PULLBACK,

                    ENABLE_ENGULFING: CONFIG.ENABLE_ENGULFING,

                    ENABLE_GAP: CONFIG.ENABLE_GAP,

                    ENABLE_TRAP_WICK: CONFIG.ENABLE_TRAP_WICK,

                    ENABLE_FALSE_BREAK: CONFIG.ENABLE_FALSE_BREAK,

                    ENABLE_STOCH_PULL: CONFIG.ENABLE_STOCH_PULL

                }

            }));

            savePairStates();

        } catch (e) {}

    }

    function savePairStates() {

        try {

            var states = {};

            for (var k in pairWatch) if (pairWatch.hasOwnProperty(k)) states[k] = { enabled: pairWatch[k].enabled, paused: pairWatch[k].paused };

            localStorage.setItem(PAIR_STATE_KEY, JSON.stringify(states));

        } catch (e) {}

    }

    function loadPairStates() {

        try { return JSON.parse(localStorage.getItem(PAIR_STATE_KEY) || '{}'); } catch (e) { return {}; }

    }

    // ==================== TELEGRAM + LOG ====================

    function uiLog(msg) {

        var t = getDisplayTime(Math.floor(Date.now() / 1000)).hms;

        localLog.push({ t: t, msg: msg });

        if (localLog.length > CONFIG.LOG_MAX_LINES) localLog.shift();

        try { console.log('[VIP]', msg); } catch (e) {}

        renderPanelLog();

    }

    function sendTelegramMessage(text) {

        if (!CONFIG.TELEGRAM_ENABLED) return;

        try {

            GM_xmlhttpRequest({

                method: 'POST',

                url: 'https://api.telegram.org/bot' + CONFIG.TELEGRAM_TOKEN + '/sendMessage',

                headers: { 'Content-Type': 'application/json' },

                data: JSON.stringify({ chat_id: CONFIG.TELEGRAM_CHAT_ID, text: text, parse_mode: 'HTML' }),

                onerror: function () { uiLog('TG error'); }

            });

        } catch (e) {}

    }

    function bootOnce() {

        if (scriptBoot) return;

        scriptBoot = true;

        sendTelegramMessage('💎 LIVE VIP 5.8 Data‑Driven Final\nFiltros CSV + Motores reactivados');

        uiLog('Bot + Panel Glass v5.8 cargado');

        ensurePanel();

    }

    // ==================== TIEMPO / PARES ====================

    function getAdjustedTime() { return Math.floor(Date.now() / 1000) + serverTimeOffset; }

    function getDisplayTime(ts) {

        var d = new Date(ts * 1000), utc = d.getTime() + d.getTimezoneOffset() * 60000, nd = new Date(utc + CONFIG.DISPLAY_UTC_OFFSET_MIN * 60000);

        function z(n) { return String(n).padStart(2, '0'); }

        return { hm: z(nd.getHours()) + ':' + z(nd.getMinutes()), hms: z(nd.getHours()) + ':' + z(nd.getMinutes()) + ':' + z(nd.getSeconds()), dateDM: z(nd.getDate()) + '/' + z(nd.getMonth() + 1) };

    }

    function normalizePairFromTick(pair) { return String(pair).toUpperCase().replace(/_OTC/gi, ' OTC').replace(/_/g, ' ').replace(/\s+/g, ' ').trim(); }

    function formatPairDisplay(pair) {

        var s = normalizePairFromTick(pair), otc = /OTC/i.test(s);

        var m = s.match(/^([A-Z]{3})\s*([A-Z]{3})/i);

        if (m) return m[1] + '/' + m[2] + (otc ? ' OTC' : '');

        m = s.match(/^([A-Z]{6})/i);

        if (m) return m[1].slice(0, 3) + '/' + m[1].slice(3, 6) + (otc ? ' OTC' : '');

        return s;

    }

    function escAttr(s) { return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

    function isPairEnabled(pairLabel) {

        if (deadZonePauseUntil[pairLabel] && Date.now() < deadZonePauseUntil[pairLabel]) return false;

        if (!pairWatch[pairLabel]) return true;

        return pairWatch[pairLabel].enabled !== false && pairWatch[pairLabel].paused !== true;

    }

    function registerPair(pairLabel) {

        if (!pairWatch[pairLabel]) {

            var saved = loadPairStates(), enabled = true, paused = false;

            if (saved[pairLabel]) { enabled = saved[pairLabel].enabled !== false; paused = saved[pairLabel].paused === true; }

            pairWatch[pairLabel] = { enabled: enabled, paused: paused, ticks: 0 };

            uiLog('Par detectado: ' + formatPairDisplay(pairLabel));

            renderPairList();

        }

        pairWatch[pairLabel].ticks += 1;

    }

    function removePairFromWatch(pairLabel) {

        delete history[pairLabel]; delete candleState[pairLabel]; delete lastEvalBucket[pairLabel];

        delete lastSignalMinuteByPair[pairLabel]; delete lastPullbackMinuteByPair[pairLabel]; delete firstTickSent[pairLabel];

        if (pendingTrades[pairLabel] && !activeTrades[pairLabel]) delete pendingTrades[pairLabel];

        delete pairWatch[pairLabel]; delete pairPayouts[pairLabel]; delete pairRecentSignals[pairLabel]; savePairStates(); renderPairList();

    }

    function updatePayoutFromDOM() {

        try {

            var items = document.querySelectorAll('.assets-favorites-item');

            for (var i = 0; i < items.length; i++) {

                var item = items[i];

                var labelEl = item.querySelector('.assets-favorites-item__label');

                if (!labelEl) continue;

                var pairName = (labelEl.textContent || '').trim();

                if (pairName.length < 6) continue;

                var pairLabel = normalizePairFromTick(pairName);

                var payoutEl = item.querySelector('.payout__in') || item.querySelector('.payout');

                if (payoutEl) {

                    var txt = (payoutEl.textContent || '').trim();

                    var m = txt.match(/\+(\d+)%?/);

                    if (m) {

                        var pct = parseInt(m[1], 10);

                        if (pct >= 50 && pct <= 95) {

                            pairPayouts[pairLabel] = pct;

                        }

                    }

                }

            }

            renderPairList();

        } catch(e) {}

    }

    setInterval(updatePayoutFromDOM, 3000);

    function resetInactivityTimer() {

        lastTickTime = Date.now();

        if (inactivityTimer) clearTimeout(inactivityTimer);

        inactivityTimer = setTimeout(function() {

            if (CONFIG.BOT_RUNNING && Date.now() - lastTickTime > 120000) {

                CONFIG.BOT_RUNNING = false;

                uiLog('⚠️ Bot pausado por inactividad (2 min sin ticks)');

                refreshPanelLive(); savePrefs();

                sendTelegramMessage('⚠️ Bot pausado automáticamente por inactividad (>2 min sin datos)');

            }

        }, 120000);

    }

    function recordPairSignal(pairLabel) {

        if (!pairRecentSignals[pairLabel]) pairRecentSignals[pairLabel] = [];

        pairRecentSignals[pairLabel].push(Date.now());

        var cutoff = Date.now() - CONFIG.PAIR_DIVERSITY_WINDOW * 60000;

        while (pairRecentSignals[pairLabel].length && pairRecentSignals[pairLabel][0] < cutoff) pairRecentSignals[pairLabel].shift();

    }

    function getPairShare(pairLabel) {

        if (!pairRecentSignals[pairLabel]) return 0;

        var cutoff = Date.now() - CONFIG.PAIR_DIVERSITY_WINDOW * 60000;

        var recent = pairRecentSignals[pairLabel].filter(ts => ts >= cutoff);

        pairRecentSignals[pairLabel] = recent;

        var total = 0;

        for (var p in pairRecentSignals) {

            if (pairRecentSignals.hasOwnProperty(p)) {

                var valid = pairRecentSignals[p].filter(ts => ts >= cutoff);

                total += valid.length;

            }

        }

        if (total === 0) return 0;

        return recent.length / total;

    }

    // ==================== CAMBIO DE PAR ====================

    function switchToFavoritePair(targetPairLabel) {

        var targetNormalized = normalizePairFromTick(targetPairLabel).toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

        var labels = document.querySelectorAll('.assets-favorites-item__label');

        for (var i = 0; i < labels.length; i++) {

            var label = labels[i];

            var txt = (label.textContent || '').trim().toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

            if (txt === targetNormalized) {

                var item = label.closest('.assets-favorites-item');

                if (item && typeof item.click === 'function') {

                    item.click();

                    return true;

                }

            }

        }

        var alistItems = document.querySelectorAll('.alist__item');

        for (var j = 0; j < alistItems.length; j++) {

            var alistText = (alistItems[j].textContent || '').trim().toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

            if (alistText.indexOf(targetNormalized) !== -1) {

                alistItems[j].click();

                return true;

            }

        }

        return false;

    }

    // ==================== AUTO‑TRADE ====================

    function getVisiblePairFromUI() {

        var selectors = [

            '[class*="current-symbol"]',

            '[class*="currentSymbol"]',

            '[class*="pair-name"]',

            '[class*="asset-name"]',

            '[class*="symbol-name"]',

            '.pair',

            '[data-symbol]'

        ];

        for (var i = 0; i < selectors.length; i++) {

            var el = document.querySelector(selectors[i]);

            if (el) {

                var txt = (el.getAttribute('data-symbol') || el.textContent || '').trim();

                if (txt.length >= 6) {

                    return txt.toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

                }

            }

        }

        return '';

    }

    function autoClickButton(direction, doubleClick) {

        if (!CONFIG.AUTOTRADE_ENABLED) return false;

        var items = document.querySelectorAll('.switch-state-block__item');

        if (items.length >= 2) {

            var btn = direction === 'CALL' ? items[0] : items[1];

            if (btn && typeof btn.click === 'function') {

                btn.click();

                if (doubleClick) { setTimeout(function() { btn.click(); }, 80); }

                return true;

            }

        }

        var todos = document.querySelectorAll('button, [role="button"], div');

        for (var i = 0; i < todos.length; i++) {

            var rect = todos[i].getBoundingClientRect();

            if (rect.width > 80 && rect.height > 30 && rect.top > window.innerHeight * 0.4) {

                if ((direction === 'CALL' && rect.left < window.innerWidth / 2) ||

                    (direction === 'PUT' && rect.left > window.innerWidth / 2)) {

                    todos[i].click();

                    if (doubleClick) { setTimeout(function() { todos[i].click(); }, 80); }

                    return true;

                }

            }

        }

        return false;

    }


        // 10. Pullback Fib (con mecha de rechazo)

        if(CONFIG.ENABLE_PULLBACK&&levels.range>0){ var rsi=getRSI(closes,CONFIG.RSI_PERIOD); function touchClassic(cur,levels,dir){ if(levels.range<=0) return false; return dir==='CALL'?cur.low<=levels.maxH-levels.range*0.5:cur.high>=levels.minL+levels.range*0.5; }

            if(maUp&&rsi<CONFIG.PULLBACK_RSI_CALL_MAX&&touchClassic(cur,levels,'CALL')&&(m.range>0&&m.lowerWick/m.range>=CONFIG.PULLBACK_REJECT_WICK)){ var score = confluenceScore('CALL',m1Sim,levels,true); addCandidate('CALL','Pullback Fib',score,0); }

            if(!maUp&&rsi>CONFIG.PULLBACK_RSI_PUT_MIN&&touchClassic(cur,levels,'PUT')&&(m.range>0&&m.upperWick/m.range>=CONFIG.PULLBACK_REJECT_WICK)){ var score = confluenceScore('PUT',m1Sim,levels,true); addCandidate('PUT','Pullback Fib',score,0); }

        }

        if (candidates.length === 0) return;

        candidates.sort(function(a, b) { return b.score - a.score; });

        var best = candidates[0];

        var maxScore = best.score;

        var topCandidates = candidates.filter(c => c.score === maxScore);

        if (topCandidates.length > 1) { best = topCandidates[Math.floor(Math.random() * topCandidates.length)]; }

        updateMotorConsecutive(best.motor);

        triggerSignal(pair, best.dir, time, best.motor, alertSec, best.score);

    }

    function hasOpenCycle() {

        for (var k in pendingTrades) if (pendingTrades.hasOwnProperty(k)) return true;

        for (k in activeTrades) if (activeTrades.hasOwnProperty(k)) return true;

        return false;

    }

    // ==================== SIGNAL & RESOLVE ====================

    function triggerSignal(pair, direction, time, motor, alertSec, confScore) {

        var nowMin = Math.floor(time / 60);

        if (nowMin - (lastSignalMinuteByPair[pair] || 0) < CONFIG.COOLDOWN_MINUTES_PER_PAIR) return false;

        if (motor === 'Pullback Fib') {

            if (nowMin - (lastPullbackMinuteByPair[pair] || 0) < CONFIG.PULLBACK_COOLDOWN_MIN) return false;

            lastPullbackMinuteByPair[pair] = nowMin;

        }

        var nowHour = Math.floor(Date.now() / 3600000);

        if (nowHour !== lastHourReset) { signalsThisHour = 0; signalsPerPairHour = {}; lastHourReset = nowHour; }

        if (signalsThisHour >= CONFIG.MAX_SIGNALS_PER_HOUR) return false;

        if ((signalsPerPairHour[pair] || 0) >= CONFIG.MAX_SIGNALS_PER_PAIR_HOUR) return false;

        signalsToday++; signalsThisHour++; signalsPerPairHour[pair] = (signalsPerPairHour[pair] || 0) + 1;

        lastSignalMinuteByPair[pair] = nowMin;

        if (!statsByMotor[motor]) statsByMotor[motor] = { w: 0, wG1: 0, l: 0 };

        var entryTs = (nowMin + 1) * 60, tDisp = getDisplayTime(entryTs);

        pendingTrades[pair] = { direction, entryTimestamp: entryTs, expiryTimestamp: entryTs + CONFIG.EXPIRY_TIME_SEC, timeStr: tDisp.hm, motor, attempt: 1, alertSec: alertSec };

        lastSignalUI = { pair: formatPairDisplay(pair), dir: direction === 'CALL' ? 'CALL' : 'PUT', motor, hm: tDisp.hm };

        if (CONFIG.AUTOTRADE_ENABLED && CONFIG.MULTI_PAR_ENABLED) {

            var signalNormalized = pair.toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

            var currentVisible = getVisiblePairFromUI();

            if (currentVisible !== signalNormalized) {

                switchToFavoritePair(pair);

            }

        }

        var isCall = direction === 'CALL';

        var payout = pairPayouts[pair] || 85;

        var confStr = confScore ? ' · conf ' + confScore + ' · seg ' + alertSec : '';

        sendTelegramMessage('💎 LIVE Edge💎\n🌐 Zona Horaria: UTC-1\n📊 DIVISA: ' + formatPairDisplay(pair) + '\n' + (isCall ? '🟩' : '🟥') + ' DIRECCIÓN: ' + (isCall ? 'CALL' : 'PUT') + '\n⏰ HORA DE ENTRADA: ' + tDisp.hm + '\n⏱ TIEMPO: 1 minuto (M1)\n🧠 ' + motor + confStr);

        uiLog('SEÑAL ' + formatPairDisplay(pair) + ' ' + direction + ' · ' + motor + confStr);

        recordPairSignal(pair);

        refreshPanelLive();

        autoKillCheck();

        return true;

    }

    function resolveTrade(pairLabel, trade, price, tickTime) {

        var motor = trade.motor, dir = trade.direction, attempt = trade.attempt || 1;

        var disp = formatPairDisplay(pairLabel), hm = trade.timeStr || getDisplayTime(tickTime).hm;

        if (!statsByMotor[motor]) statsByMotor[motor] = { w: 0, wG1: 0, l: 0 };

        if ((dir==='CALL' && price>trade.entryPrice) || (dir==='PUT' && price<trade.entryPrice)) {

            if (attempt === 1) { statsByMotor[motor].w++; tradeHistory.push({result:'WIN',motor}); sessionLog.push({pair:disp,hm,win:true,g1:false,dateDM:getDisplayTime(tickTime).dateDM}); }

            else { statsByMotor[motor].wG1++; tradeHistory.push({result:'WIN_G1',motor}); sessionLog.push({pair:disp,hm,win:true,g1:true,dateDM:getDisplayTime(tickTime).dateDM}); }

            sendTelegramMessage('✅ <b>WIN</b>' + (attempt===2?' (G1)':'') + '\n' + hm + ' | ' + disp + '\n🧠 ' + motor);

            uiLog('WIN' + (attempt===2?' G1':'') + ' ' + disp + ' · ' + motor);

            updateMotorRecent(motor, true);

            delete activeTrades[pairLabel];

            if (attempt === 1 || attempt === 2) { cyclesToday++; }

            maybeSummary(); refreshPanelLive(); return;

        }

        // LOSS: registrar datos

        var curCandle = candleState[pairLabel]?.m1;

        var curMetrics = curCandle ? candleMetrics(curCandle) : {};

        lossLog.push({

            date: getDisplayTime(tickTime).dateDM,

            time: getDisplayTime(tickTime).hm,

            pair: disp,

            motor: motor,

            dir: dir,

            open: curCandle?.open?.toFixed(5) || '',

            close: curCandle?.close?.toFixed(5) || '',

            high: curCandle?.high?.toFixed(5) || '',

            low: curCandle?.low?.toFixed(5) || '',

            upperWick: curMetrics.upperWick?.toFixed(5) || '',

            lowerWick: curMetrics.lowerWick?.toFixed(5) || '',

            body: curMetrics.body?.toFixed(5) || '',

            rsi: getRSI((history[pairLabel]?.m1||[]).map(c=>c.close).concat([curCandle?.close||0]), CONFIG.RSI_PERIOD),

            payout: pairPayouts[pairLabel] || 85,

            ticks: tickCountByPair[pairLabel] || 0

        });

        var payout = pairPayouts[pairLabel] || 85;

        var allowMartingale = CONFIG.MARTINGALE_ENABLED && payout >= CONFIG.MIN_PAYOUT_FOR_MARTINGALE;

        if (attempt===1 && allowMartingale && CONFIG.MARTINGALE_STEPS>=1) {

            var gTs=Math.floor(tickTime), gExp=gTs+CONFIG.EXPIRY_TIME_SEC;

            activeTrades[pairLabel] = { direction:dir, entryPrice:price, entryTimestamp:gTs, expiryTimestamp:gExp, timeStr:getDisplayTime(gTs).hm, motor, attempt:2 };

            if (CONFIG.AUTOTRADE_ENABLED) {

                var visiblePair = getVisiblePairFromUI();

                var signalPairNormalized = pairLabel.toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

                if (visiblePair === signalPairNormalized) {

                    autoClickButton(dir, true);

                } else if (CONFIG.MULTI_PAR_ENABLED && switchToFavoritePair(pairLabel)) {

                    setTimeout(function() { autoClickButton(dir, true); }, 400);

                } else {

                    uiLog('⏭️ AutoTrade Gale: par no coincide');

                }

            }

            sendTelegramMessage('🌀 GALE 1\n' + disp + '\n' + (dir==='CALL'?'🟩':'🟥') + ' ' + (dir==='CALL'?'CALL':'PUT') + ' · ' + motor + '\n⏰ Exp ~' + getDisplayTime(gExp).hm + ' (UTC-1)');

            uiLog('GALE1 ' + disp); refreshPanelLive(); return;

        }

        statsByMotor[motor].l++; tradeHistory.push({result:'LOSS',motor}); sessionLog.push({pair:disp,hm,win:false,g1:false,dateDM:getDisplayTime(tickTime).dateDM});

        sendTelegramMessage('❌ <b>LOSS</b>' + (attempt===2?' (G1)':'') + '\n' + hm + ' | ' + disp + '\n🧠 ' + motor);

        uiLog('LOSS ' + disp + ' · ' + motor);

        updateMotorRecent(motor, false);

        delete activeTrades[pairLabel];

        if (attempt === 1 || attempt === 2) { cyclesToday++; }

        maybeSummary(); refreshPanelLive();

    }

    function maybeSummary() { if (sessionLog.length && sessionLog.length % CONFIG.SUMMARY_EVERY_N === 0) sendTelegramMessage(buildSessionSummary()); }

    function buildSessionSummary() {

        var dateStr = sessionLog.length ? sessionLog[0].dateDM : getDisplayTime(Math.floor(getAdjustedTime())).dateDM;

        var lines = ['📋 <b>RESUMEN VIP Glass v5.8 (' + dateStr + ')</b> 📋', '━━━━━━━━━━━━━━━━━━'], wins=0,losses=0;

        for (var i=0; i<sessionLog.length; i++) { var o=sessionLog[i]; if(o.win) { wins++; lines.push('✅ '+o.hm+' | '+o.pair+' ➔ '+(o.g1?'WIN G1':'WIN')); } else { losses++; lines.push('❌ '+o.hm+' | '+o.pair+' ➔ LOSS'); } }

        var tot=wins+losses, wr=tot?Math.round(wins/tot*100):0;

        lines.push('━━━━━━━━━━━━━━━━━━','📊 <b>BALANCE</b>','🏆 '+String(wins).padStart(2,'0')+'W | 🛑 '+String(losses).padStart(2,'0')+'L','📈 WR: <b>'+wr+'%</b>','🎯 '+cyclesToday+'/'+CONFIG.MAX_SIGNALS_SESSION+' ciclos');

        lines.push('🧠 <b>Por motor:</b>');

        for (var m in statsByMotor) { var s=statsByMotor[m], totalM=s.w+s.wG1+s.l; if(totalM>0) lines.push(m+': '+(s.w+s.wG1)+'W / '+s.l+'L'); }

        return lines.join('\n');

    }

    // ==================== PROCESAR TICKS ====================

    function processTick(pair, time, price) {

        try {

            if (typeof pair !== 'string' || !isFinite(time) || !isFinite(price)) return;

            if (serverTimeOffset === 0) { serverTimeOffset = time - Math.floor(Date.now() / 1000); uiLog('⏱️ Sincronización: offset servidor = ' + serverTimeOffset + 's'); }

            var pairLabel = normalizePairFromTick(pair);

            registerPair(pairLabel); resetInactivityTimer();

            var block60 = Math.floor(time / 60);

            if (!tickCountByPair[pairLabel] || candleState[pairLabel]?.m1?.block !== block60) tickCountByPair[pairLabel] = 1;

            else tickCountByPair[pairLabel]++;

            if (activeTrades[pairLabel] && time >= activeTrades[pairLabel].expiryTimestamp) resolveTrade(pairLabel, activeTrades[pairLabel], price, time);

            if (pendingTrades[pairLabel] && !activeTrades[pairLabel]) {

                var pend = pendingTrades[pairLabel];

                if (time >= pend.entryTimestamp) {

                    if (time - pend.entryTimestamp > 8) { uiLog('⌛ Pendiente expirada sin entrada: ' + formatPairDisplay(pairLabel)); delete pendingTrades[pairLabel]; }

                    else {

                        activeTrades[pairLabel] = { direction: pend.direction, entryPrice: price, entryTimestamp: pend.entryTimestamp, expiryTimestamp: pend.expiryTimestamp, timeStr: pend.timeStr, motor: pend.motor, attempt: 1, alertSec: pend.alertSec };

                        delete pendingTrades[pairLabel];

                        uiLog('Entrada ' + formatPairDisplay(pairLabel));

                        if (CONFIG.AUTOTRADE_ENABLED) {

                            var visiblePair = getVisiblePairFromUI();

                            var signalPairNormalized = pairLabel.toUpperCase().replace(/\s+/g, '').replace(/OTC/g, '').replace(/\//g, '');

                            if (visiblePair === signalPairNormalized) {

                                autoClickButton(pend.direction, false);

                            } else if (CONFIG.MULTI_PAR_ENABLED) {

                                if (switchToFavoritePair(pairLabel)) {

                                    setTimeout(function() { autoClickButton(pend.direction, false); }, 300);

                                } else {

                                    uiLog('⏭️ AutoTrade: no se pudo cambiar a ' + formatPairDisplay(pairLabel));

                                }

                            } else {

                                uiLog('⏭️ AutoTrade: par no coincide');

                            }

                        }

                    }

                } else if (pend.entryTimestamp - time > 90) delete pendingTrades[pairLabel];

            }

            if (!history[pairLabel]) history[pairLabel] = { s15: [], m1: [], m5: [] };

            var block15 = Math.floor(time / 15), block300 = Math.floor(time / 300);

            if (!candleState[pairLabel]) candleState[pairLabel] = { s15: { block: block15, open: price, high: price, low: price, close: price }, m1: { block: block60, open: price, high: price, low: price, close: price }, m5: { block: block300, open: price, high: price, low: price, close: price } };

            var state = candleState[pairLabel];

            function roll(tf, block, key, max) {

                if (state[tf].block !== block) { history[pairLabel][key].push({ open: state[tf].open, high: state[tf].high, low: state[tf].low, close: state[tf].close }); if (history[pairLabel][key].length > max) history[pairLabel][key].shift(); state[tf] = { block: block, open: price, high: price, low: price, close: price }; if (tf === 'm1') tickCountByPair[pairLabel] = 1; }

                else { state[tf].high = Math.max(state[tf].high, price); state[tf].low = Math.min(state[tf].low, price); state[tf].close = price; }

            }

            roll('s15', block15, 's15', 80); roll('m1', block60, 'm1', 40); roll('m5', block300, 'm5', 12);

            if (!isPairEnabled(pairLabel) || !CONFIG.BOT_RUNNING || cyclesToday >= CONFIG.MAX_SIGNALS_SESSION) return;

            if (CONFIG.OPERATION_MODE==='normal' && hasOpenCycle()) return;

            if (activeTrades[pairLabel] || pendingTrades[pairLabel]) return;

            var secInMin = time % 60;

            if (secInMin < CONFIG.EVAL_SEC_START || secInMin > CONFIG.EVAL_SEC_END) return;

            var bucket = CONFIG.EVAL_BUCKETS[0];

            for (var bi=0; bi<CONFIG.EVAL_BUCKETS.length; bi++) if (secInMin >= CONFIG.EVAL_BUCKETS[bi]) bucket = CONFIG.EVAL_BUCKETS[bi];

            if (lastEvalBucket[pairLabel] === block60+':'+bucket) return;

            lastEvalBucket[pairLabel] = block60+':'+bucket;

            evaluateAll(pairLabel, time, history[pairLabel].m1.concat([state.m1]), history[pairLabel].s15.concat([state.s15]), secInMin);

        } catch (err) { console.error('[VIP processTick]', err); uiLog('ERR processTick'); }

    }

    setInterval(function() { var now=getAdjustedTime(); for(var p in pendingTrades) if(pendingTrades.hasOwnProperty(p)&&now>pendingTrades[p].entryTimestamp+15){ uiLog('🧹 Limpiando pendiente: '+formatPairDisplay(p)); delete pendingTrades[p]; } },3000);

    // WebSocket

    function extractTicks(obj) { if(obj==null) return; if(Array.isArray(obj)){ if(obj.length>=3&&typeof obj[0]==='string'&&typeof obj[1]==='number'&&typeof obj[2]==='number'){ processTick(obj[0],obj[1],obj[2]); return; } for(var i=0;i<obj.length;i++) extractTicks(obj[i]); return; } if(typeof obj!=='object') return; for(var key in obj){ if(!obj.hasOwnProperty(key)) continue; var val=obj[key]; if(val&&typeof val==='object'&&!Array.isArray(val)&&val.time!=null&&val.price!=null){ var t=Number(val.time),p=Number(val.price); if(isFinite(t)&&isFinite(p)) processTick(key,t,p); } else if(val&&typeof val==='object') extractTicks(val); } }

    function tryParseText(msg){ if(typeof msg!=='string') return; var i=msg.search(/[\{\[]/); if(i===-1) return; try{ extractTicks(JSON.parse(msg.substring(i))); }catch(e){} }

    function handleBinaryFrame(buf){ try{ var text=new TextDecoder('utf-8',{fatal:false}).decode(new Uint8Array(buf)),j=text.search(/[\{\[]/); if(j!==-1) try{ extractTicks(JSON.parse(text.substring(j))); }catch(e2){} }catch(e){} }

    var OriginalWS = win.WebSocket;

    win.WebSocket = function(url,protocols){ var ws=protocols!==undefined?new OriginalWS(url,protocols):new OriginalWS(url); ws.addEventListener('message',function(e){ var d=e.data; if(typeof d==='string'){ tryParseText(d); return; } if(typeof Blob!=='undefined'&&d instanceof Blob) d.arrayBuffer().then(handleBinaryFrame).catch(function(){}); else if(typeof ArrayBuffer!=='undefined'&&d instanceof ArrayBuffer) handleBinaryFrame(d); }); return ws; };

    win.WebSocket.prototype = OriginalWS.prototype;

    function startUiWhenReady() { if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',function(){ bootOnce(); ensurePanel(); }); else{ bootOnce(); ensurePanel(); } setTimeout(ensurePanel,1500); setTimeout(ensurePanel,4000); }

    startUiWhenReady();

